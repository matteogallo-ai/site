{
  "name": "matteogallo-site",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --experimental-strip-types --test \"scripts/**/*.test.ts\" \"src/**/*.test.ts\"",
    "check:links": "node --experimental-strip-types scripts/check-links.ts",
    "test:a11y": "playwright test",
    "lighthouse": "lhci autorun",
    "measures": "node --experimental-strip-types scripts/site-measures.ts",
    "fonts": ".venv/bin/python scripts/fonts/subset.py",
    "check:sources": "node --experimental-strip-types scripts/check-sources.ts",
    "og": "node --experimental-strip-types scripts/og.ts",
    "icons": "node --experimental-strip-types scripts/icons.ts",
    "check:rulesets": "node --experimental-strip-types scripts/check-rulesets.ts"
  },
  "dependencies": {
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "linkinator": "8.1.0",
    "sharp": "0.35.5",
    "typescript": "6.0.2"
  },
  "overrides": {
    "basic-ftp": "6.2.6",
    "glob@>=9.0.0 <14.0.2": "14.0.3",
    "minimatch@>=7.0.0 <11.0.1": "11.0.4",
    "linkinator": {
      "glob": "14.0.3"
    }
  }
}
