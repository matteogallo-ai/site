{
  "name": "matteogallo-site",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --experimental-strip-types --test \"scripts/**/*.test.ts\" \"src/**/*.test.ts\"",
    "check:links": "linkinator dist --config linkinator.config.json",
    "test:a11y": "playwright test",
    "lighthouse": "lhci autorun",
    "measures": "node --experimental-strip-types scripts/site-measures.ts"
  },
  "dependencies": {
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "linkinator": "8.1.0",
    "typescript": "6.0.2"
  },
  "overrides": {
    "basic-ftp": "6.2.6",
    "glob@>=9.0.0 <14.0.2": "14.0.3",
    "minimatch@>=7.0.0 <11.0.1": "11.0.4",
    "linkinator": {
      "glob": "14.0.3"
    }
  }
}
