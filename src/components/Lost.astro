---
import Base from "../layouts/Base.astro";
import { langOf } from "../lib/i18n.ts";
import LangSwitch from "./LangSwitch.astro";

// The 404 page in either language (src/pages/404.astro, src/pages/en/404.astro).
const fr = langOf(Astro.url.pathname) === "fr";
---

<Base
  title={fr ? "Page introuvable — Matteo Gallo" : "Page not found — Matteo Gallo"}
  description={fr ? "Aucune page à cette adresse sur le site de Matteo Gallo." : "No page at this address on Matteo Gallo’s site."}
  canonical={false}
>
  <p class="container top"><LangSwitch /></p>
  <section class="container lost" aria-labelledby="lost-title">
    <h1 id="lost-title">{fr ? "Aucune preuve à cette adresse." : "No proof at this address."}</h1>
    <p><a class="home" href={fr ? "/" : "/en/"}>{fr ? "Retour à l’accueil" : "Back to the home page"}</a></p>
  </section>
</Base>

<style>
  .top {
    display: flex;
    justify-content: flex-end;
    margin-block: 1.5rem 0;
  }

  .lost {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
  }

  h1 {
    font-size: var(--step-44);
    letter-spacing: var(--track-44);
    max-width: 16em;
  }

  .home {
    font-size: var(--step-21);
  }
</style>
