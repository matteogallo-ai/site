---
import Figure from "./Figure.astro";
import ProductShot from "./ProductShot.astro";
import { langOf, twin } from "../lib/i18n.ts";

const repo = (name: string) => `https://github.com/matteogallo-ai/${name}`;
const lang = langOf(Astro.url.pathname);
const fr = lang === "fr";
const study = (slug: string) => (lang === "fr" ? `/projets/${slug}/` : twin(`/projets/${slug}/`));
const t = {
  fr: { id: "projets", title: "Projets", limit: "Limite\u00A0:", read: "Lire l’étude de cas →", code: "Code sur GitHub" },
  en: { id: "projects", title: "Projects", limit: "Limit:", read: "Read the case study →", code: "Code on GitHub" },
}[lang];
---

<section class="container section reveal" id={t.id} aria-labelledby={`${t.id}-title`}>
  <p class="mono rule-label">+ 01</p>
  <h2 id={`${t.id}-title`}>{t.title}</h2>
  <div class="projects">
    <article class="project card" aria-labelledby="p-verity">
      <h3 id="p-verity"><a class="card-link" href={study("verity")}>Verity</a></h3>
      <ProductShot id="verity" size="card" />
      <p>{fr ? "Assistant de questions-réponses sur des documents d’entreprise : chaque réponse cite le passage source, et l’absence de preuve produit un refus." : "Question answering over company documents: every answer cites its source passage, and missing evidence produces a refusal."}</p>
      <p class="figure-line"><Figure id="verity.twoarm_unanswerable_answered_verity" where="card" /> {fr ? "questions sans réponse traitées comme si elles en avaient une, contre" : "unanswerable questions answered as if they had an answer, against"} <Figure id="verity.twoarm_unanswerable_answered_naive" where="card" /> {fr ? "pour un RAG naïf (même recherche, sans contrôles ; test apparié, p =" : "for a naive RAG (same retrieval, no checks; paired test, p ="} <Figure id="verity.twoarm_unanswerable_answered_p" where="card" />)</p>
      <p class="limit"><span class="k">{t.limit}</span> <Figure id="verity.unanswerable_answered" where="card" defect text="5" /> {fr ? "questions sans réponse ont reçu une réponse au lieu d’un refus." : "unanswerable questions got an answer instead of a refusal."}</p>
      <p class="stack">Python 3.12, FastAPI, Postgres + pgvector, Next.js, Claude.</p>
      <p class="links"><a class="button" href={study("verity")}>{t.read}</a> <a href={repo("verity")}>{t.code}</a></p>
    </article>

    <article class="project card" aria-labelledby="p-promptlang">
      <h3 id="p-promptlang"><a class="card-link" href={study("promptlang")}>PromptLang</a></h3>
      <ProductShot id="promptlang" size="card" />
      <p>{fr ? "Langage typé pour les prompts LLM, compilé vers TypeScript et Python, publié sur npm." : "A typed language for LLM prompts, compiled to TypeScript and Python, published on npm."}</p>
      <p class="figure-line"><Figure id="promptlang.mutation_score" where="card" /> — {fr ? "score de mutation (lexer, parser, semver ; exécution locale, hors CI)" : "mutation score (lexer, parser, semver; local run, not in CI)"}</p>
      <p class="limit"><span class="k">{t.limit}</span> {fr ? "Linter IA :" : "AI linter,"} <Figure id="promptlang.linter_precision_reviewed" where="card" defect text={fr ? "12 signalements justes sur 40" : "12 of 40 findings"} /> {fr ? "en revue humaine." : "correct in human review."}</p>
      <p class="stack">{fr ? "TypeScript strict, Bun, npm." : "Strict TypeScript, Bun, npm."}</p>
      <p class="links"><a class="button" href={study("promptlang")}>{t.read}</a> <a href={repo("promptlang")}>{t.code}</a></p>
    </article>

    <article class="project card" aria-labelledby="p-praxis">
      <h3 id="p-praxis"><a class="card-link" href={study("praxis")}>Praxis</a></h3>
      <ProductShot id="praxis" size="card" />
      <p>{fr ? "Pipeline qui transforme une question business en briefing d’analyse sourcé, avec relecture adverse automatique." : "A pipeline that turns a business question into a sourced analysis briefing, with automatic adversarial review."}</p>
      <p class="figure-line"><Figure id="praxis.cost_per_briefing" where="card" /> — {fr ? "par briefing live terminé" : "per completed live briefing"}</p>
      <p class="limit"><span class="k">{t.limit}</span> {fr ? "Les" : "all"} <Figure id="praxis.insufficiently_sourced" where="card" defect text="6" /> {fr ? "briefings live terminés sont signalés insuffisamment sourcés par son propre contrôle." : "completed live briefings are flagged as under-sourced by its own check."}</p>
      <p class="stack">{fr ? "TypeScript, Bun ; sorties Markdown, PDF, DOCX." : "TypeScript, Bun; Markdown, PDF and DOCX output."}</p>
      <p class="links"><a class="button" href={study("praxis")}>{t.read}</a> <a href={repo("praxis")}>{t.code}</a></p>
    </article>
  </div>
</section>

<style>
  .projects {
    display: grid;
    gap: 2.5rem var(--gutter);
  }

  @media (min-width: 64rem) {
    .projects {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* A column: the links sit at the foot of each card, level across the row. */
  .project {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }

  /* The way in, at the foot of each card and level across the row: a button to the case study,
     the code beside it. */
  .project .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .project .links .button {
    font-size: var(--step-14);
  }

  /* Underlined, the title would read as one more link among the card's; the card's hover and focus ring say it opens. */
  h3 .card-link {
    color: inherit;
    text-decoration: none;
  }

  .project p {
    margin: 0.75rem 0 0;
  }

  /* The whole card opens its case study (.card, global.css), its plain words included. Only the
     links it holds sit above the stretched link; the one under the pointer or the keyboard rises
     above its neighbours, so its proof tooltip is not drawn under the next line. */
  .project :global(figcaption a),
  .figure-line :global(a),
  .limit :global(a),
  .links a:not(.card-link) {
    position: relative;
    z-index: 1;
  }

  .project :global(figcaption a):is(:hover, :focus-visible),
  .figure-line :global(a):is(:hover, :focus-visible),
  .limit :global(a):is(:hover, :focus-visible) {
    z-index: 2;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project:hover :global(.shot img) {
      transform: scale(1.02);
    }
  }

  .figure-line {
    font-size: var(--step-14);
  }

  /* The limit is the project's known defect: its label carries the defect colour, the text stays ink. */
  .limit {
    font-size: var(--step-14);
  }

  .limit .k {
    color: var(--defect);
    font-weight: 600;
  }

  .limit :global(.figure.defect) {
    color: var(--ink);
  }

  .stack {
    font-size: var(--step-14);
    color: var(--graphite);
  }

  .links {
    font-size: var(--step-14);
  }
</style>
