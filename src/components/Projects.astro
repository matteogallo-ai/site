---
import Figure from "./Figure.astro";
import ProductShot from "./ProductShot.astro";
import { langOf, twin } from "../lib/i18n.ts";
import { pinned } from "../lib/sources.ts";

const repo = (name: string) => `https://github.com/matteogallo-ai/${name}`;
const lang = langOf(Astro.url.pathname);
const fr = lang === "fr";
const study = (slug: string) => (lang === "fr" ? `/projets/${slug}/` : twin(`/projets/${slug}/`));
const t = {
  fr: { id: "projets", title: "Projets", read: "Lire l’étude de cas →", code: "Code sur GitHub", experiments: "Expériences" },
  en: { id: "projects", title: "Projects", read: "Read the case study →", code: "Code on GitHub", experiments: "Experiments" },
}[lang];
---

<section class="container section reveal" id={t.id} aria-labelledby={`${t.id}-title`}>
  <p class="mono rule-label">+ 01</p>
  <h2 id={`${t.id}-title`}>{t.title}</h2>
  <div class="projects">
    <article class="project card" aria-labelledby="p-verity">
      <h3 id="p-verity"><a class="card-link" href={study("verity")}>Verity</a></h3>
      <ProductShot id="verity" size="card" />
      <p>{fr ? "Assistant de questions-réponses sur des documents : chaque réponse cite le passage source, et il est conçu pour refuser quand la preuve manque." : "Question answering over documents: every answer cites its source passage, and it is designed to refuse when the evidence is missing."}</p>
      <p class="figure-line"><Figure id="verity.twoarm_unanswerable_answered_verity" where="card" sentence /> {fr ? "questions sans réponse traitées comme si elles en avaient une, contre" : "unanswerable questions answered as if they had an answer, against"} <Figure id="verity.twoarm_unanswerable_answered_naive" where="card" sentence /> {fr ? "pour la même chaîne sans contrôles" : "for the same pipeline without checks"}</p>
      <p class="links"><a class="button" href={study("verity")}>{t.read}</a> <a href={repo("verity")}>{t.code}</a></p>
    </article>

    <article class="project card" aria-labelledby="p-promptlang">
      <h3 id="p-promptlang"><a class="card-link" href={study("promptlang")}>PromptLang</a></h3>
      <ProductShot id="promptlang" size="card" />
      <p>{fr ? "Compilateur pour un langage typé de prompts : génère du code TypeScript et Python, publié sur npm." : "A compiler for a typed prompt language: generates TypeScript and Python, published on npm."}</p>
      <p class="figure-line"><Figure id="promptlang.mutation_score" where="card" sentence /> {fr ? "des" : "of"} <Figure id="promptlang.mutants_total" where="card" sentence /> {fr ? "mutants détectés par ses tests (erreurs introduites exprès dans la lecture du langage et le contrôle de version)" : "mutants detected by its tests (errors deliberately introduced into the language reader and the version check)"}</p>
      <p class="links"><a class="button" href={study("promptlang")}>{t.read}</a> <a href={repo("promptlang")}>{t.code}</a></p>
    </article>
  </div>

  {/* A project whose result did not hold stays on the page as an experiment, with that result, not as a project card. */}
  <div class="experiments">
    <h3>{t.experiments}</h3>
    <ul>
      <li>
        <a href={study("praxis")}>Praxis</a> — {fr ? "pipeline d’analyse en" : "a"} {fr ? <span class="keep"><Figure id="praxis.stages" where="experiments" text="7 étapes" /> ;</span> : <Figure id="praxis.stages" where="experiments" text="7-stage" />}{fr ? " comparé à l’aveugle, sur une question, à un appel unique" : " analysis pipeline; compared blind, on one question, with a single call"} <Figure id="praxis.q12_cost_ratio" where="experiments" text={fr ? "9,8× moins cher" : "9.8× cheaper"} />{fr ? " : le relecteur a préféré l’appel unique." : ": the reviewer preferred the single call."} <a href={`${pinned("praxis", "README.md")}#status`}>{fr ? "Résultat publié" : "Result published"}</a>.
      </li>
    </ul>
  </div>
</section>

<style>
  .projects {
    display: grid;
    gap: 2.5rem var(--gutter);
  }

  @media (min-width: 64rem) {
    .projects {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* A column: the links sit at the foot of each card, level across the row. */
  .project {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }

  /* The way in, at the foot of each card and level across the row: a button to the case study,
     the code beside it. */
  .project .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .project .links .button {
    font-size: var(--step-14);
  }

  /* Underlined, the title would read as one more link among the card's; the card's hover and focus ring say it opens. */
  h3 .card-link {
    color: inherit;
    text-decoration: none;
  }

  .project p {
    margin: 0.75rem 0 0;
  }

  /* The whole card opens its case study (.card, global.css), its plain words included. Only the
     links it holds sit above the stretched link; the one under the pointer or the keyboard rises
     above its neighbours, so its proof tooltip is not drawn under the next line. */
  .project :global(figcaption a),
  .figure-line :global(a),
  .links a:not(.card-link) {
    position: relative;
    z-index: 1;
  }

  .project :global(figcaption a):is(:hover, :focus-visible),
  .figure-line :global(a):is(:hover, :focus-visible) {
    z-index: 2;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project:hover :global(.shot img) {
      transform: scale(1.02);
    }
  }

  .figure-line {
    font-size: var(--step-14);
  }

  .experiments {
    margin-top: 2.5rem;
    font-size: var(--step-14);
  }

  .experiments h3 {
    margin: 0;
  }

  /* A line may break after an inline-block figure even before a no-break space: the French « ; »
     stays with its figure. */
  .keep {
    white-space: nowrap;
  }

  .experiments ul {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .links {
    font-size: var(--step-14);
  }
</style>
