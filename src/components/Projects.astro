---
import Figure from "./Figure.astro";
import ProductShot from "./ProductShot.astro";
import { langOf, twin } from "../lib/i18n.ts";

const repo = (name: string) => `https://github.com/matteogallo-ai/${name}`;
const lang = langOf(Astro.url.pathname);
const fr = lang === "fr";
const study = (slug: string) => (lang === "fr" ? `/projets/${slug}/` : twin(`/projets/${slug}/`));
const t = {
  fr: { id: "projets", title: "Projets", wip: "en cours", read: "Lire l’étude de cas →", code: "Code sur GitHub" },
  en: { id: "projects", title: "Projects", wip: "in progress", read: "Read the case study →", code: "Code on GitHub" },
}[lang];
---

<section class="container section reveal" id={t.id} aria-labelledby={`${t.id}-title`}>
  <p class="mono rule-label">+ 01</p>
  <h2 id={`${t.id}-title`}>{t.title}</h2>
  <div class="projects">
    <article class="project card" aria-labelledby="p-verity">
      <h3 id="p-verity"><a class="card-link" href={study("verity")}>Verity</a></h3>
      <ProductShot id="verity" size="card" />
      <p>{fr ? "Assistant de questions-réponses sur des documents d’entreprise : chaque réponse cite le passage source, et l’absence de preuve produit un refus." : "Question answering over company documents: every answer cites its source passage, and missing evidence produces a refusal."}</p>
      <p class="figure-line"><Figure id="verity.twoarm_unanswerable_answered_verity" where="card" sentence /> {fr ? "questions sans réponse traitées comme si elles en avaient une, contre" : "unanswerable questions answered as if they had an answer, against"} <Figure id="verity.twoarm_unanswerable_answered_naive" where="card" sentence /> {fr ? "pour un RAG naïf (même recherche, sans contrôles ; test apparié, p =" : "for a naive RAG (same retrieval, no checks; paired test, p ="} <Figure id="verity.twoarm_unanswerable_answered_p" where="card" sentence />)</p>
      <p class="links"><a class="button" href={study("verity")}>{t.read}</a> <a href={repo("verity")}>{t.code}</a></p>
    </article>

    <article class="project card" aria-labelledby="p-promptlang">
      <h3 id="p-promptlang"><a class="card-link" href={study("promptlang")}>PromptLang</a></h3>
      <ProductShot id="promptlang" size="card" />
      <p>{fr ? "Langage typé pour écrire les consignes (prompts) des modèles de langage, compilé vers TypeScript et Python, publié sur npm." : "A typed language for writing the instructions (prompts) given to language models, compiled to TypeScript and Python, published on npm."}</p>
      <p class="figure-line"><Figure id="promptlang.mutation_score" where="card" sentence /> {fr ? "des erreurs introduites exprès dans la lecture du langage sont repérées par ses tests" : "of the errors deliberately introduced into the language reader are caught by its tests"}</p>
      <p class="links"><a class="button" href={study("promptlang")}>{t.read}</a> <a href={repo("promptlang")}>{t.code}</a></p>
    </article>

    <article class="project card" aria-labelledby="p-praxis">
      <h3 id="p-praxis"><a class="card-link" href={study("praxis")}>Praxis</a> <span class="wip">{t.wip}</span></h3>
      <ProductShot id="praxis" size="card" />
      <p>{fr ? "Prépare, à partir d’une question métier, un briefing d’analyse qui cite ses sources, relu par un second modèle chargé d’en trouver les failles." : "Prepares, from a business question, an analysis briefing that cites its sources, reviewed by a second model tasked with finding its flaws."}</p>
      <p class="figure-line"><Figure id="praxis.cost_per_briefing" where="card" sentence /> {fr ? "d’appels au modèle par briefing réel terminé, sur" : "in model calls per completed real briefing, over"} <Figure id="praxis.live_completed" where="card" text="6" /> {fr ? "briefings" : "briefings"}</p>
      <p class="links"><a class="button" href={study("praxis")}>{t.read}</a> <a href={repo("praxis")}>{t.code}</a></p>
    </article>
  </div>
</section>

<style>
  .projects {
    display: grid;
    gap: 2.5rem var(--gutter);
  }

  @media (min-width: 64rem) {
    .projects {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* A column: the links sit at the foot of each card, level across the row. */
  .project {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }

  /* The way in, at the foot of each card and level across the row: a button to the case study,
     the code beside it. */
  .project .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .project .links .button {
    font-size: var(--step-14);
  }

  /* Underlined, the title would read as one more link among the card's; the card's hover and focus ring say it opens. */
  h3 .card-link {
    color: inherit;
    text-decoration: none;
  }

  .project p {
    margin: 0.75rem 0 0;
  }

  /* The whole card opens its case study (.card, global.css), its plain words included. Only the
     links it holds sit above the stretched link; the one under the pointer or the keyboard rises
     above its neighbours, so its proof tooltip is not drawn under the next line. */
  .project :global(figcaption a),
  .figure-line :global(a),
  .links a:not(.card-link) {
    position: relative;
    z-index: 1;
  }

  .project :global(figcaption a):is(:hover, :focus-visible),
  .figure-line :global(a):is(:hover, :focus-visible) {
    z-index: 2;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project:hover :global(.shot img) {
      transform: scale(1.02);
    }
  }

  .figure-line {
    font-size: var(--step-14);
  }

  /* The project still being proven says so beside its name, in small type, not as a defect. */
  .wip {
    margin-left: 0.4rem;
    padding: 0.1rem 0.5rem;
    font-size: var(--step-12);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--graphite);
    border: 1px solid var(--rule);
    border-radius: 999px;
    vertical-align: middle;
  }

  .links {
    font-size: var(--step-14);
  }
</style>
