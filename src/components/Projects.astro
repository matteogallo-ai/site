---
import Figure from "./Figure.astro";
import ProductShot from "./ProductShot.astro";
import { langOf, twin } from "../lib/i18n.ts";

const repo = (name: string) => `https://github.com/matteogallo-ai/${name}`;
const lang = langOf(Astro.url.pathname);
const fr = lang === "fr";
const study = (slug: string) => (lang === "fr" ? `/projets/${slug}/` : twin(`/projets/${slug}/`));
const t = {
  fr: { id: "projets", title: "Projets", limit: "Limite\u00A0:", study: "Étude de cas" },
  en: { id: "projects", title: "Projects", limit: "Limit:", study: "Case study" },
}[lang];
---

<section class="container section reveal" id={t.id} aria-labelledby={`${t.id}-title`}>
  <p class="mono rule-label">+ 01</p>
  <h2 id={`${t.id}-title`}>{t.title}</h2>
  <div class="projects">
    <article class="project card" aria-labelledby="p-verity">
      <h3 id="p-verity">Verity</h3>
      <ProductShot id="verity" size="card" />
      <p>{fr ? "Assistant de questions-réponses sur des documents d’entreprise : chaque réponse cite le passage source, et l’absence de preuve produit un refus." : "Question answering over company documents: every answer cites its source passage, and missing evidence produces a refusal."}</p>
      <p class="figure-line"><Figure id="verity.refusal_recall" where="card" /> — {fr ? "questions sans réponse correctement refusées" : "unanswerable questions correctly refused"}</p>
      <p class="limit"><span class="k">{t.limit}</span> <Figure id="verity.unanswerable_answered" where="card" defect text="3" /> {fr ? "questions sans réponse ont reçu une réponse au lieu d’un refus." : "unanswerable questions got an answer instead of a refusal."}</p>
      <p class="stack">Python 3.12, FastAPI, Postgres + pgvector, Next.js, Claude.</p>
      <p class="links"><a class="card-link" href={study("verity")} aria-label={`${t.study} Verity`}>{t.study}</a> · <a href={repo("verity")}>Code</a></p>
    </article>

    <article class="project card" aria-labelledby="p-promptlang">
      <h3 id="p-promptlang">PromptLang</h3>
      <ProductShot id="promptlang" size="card" />
      <p>{fr ? "Langage typé pour les prompts LLM, compilé vers TypeScript et Python, publié sur npm." : "A typed language for LLM prompts, compiled to TypeScript and Python, published on npm."}</p>
      <p class="figure-line"><Figure id="promptlang.mutation_score" where="card" /> — {fr ? "score de mutation (lexer, parser, semver)" : "mutation score (lexer, parser, semver)"}</p>
      <p class="limit"><span class="k">{t.limit}</span> {fr ? "Linter IA :" : "AI linter,"} <Figure id="promptlang.linter_precision_reviewed" where="card" defect text={fr ? "12 signalements justes sur 40" : "12 of 40 findings"} /> {fr ? "en revue humaine." : "correct in human review."}</p>
      <p class="stack">{fr ? "TypeScript strict, Bun, npm." : "Strict TypeScript, Bun, npm."}</p>
      <p class="links"><a class="card-link" href={study("promptlang")} aria-label={`${t.study} PromptLang`}>{t.study}</a> · <a href={repo("promptlang")}>Code</a></p>
    </article>

    <article class="project card" aria-labelledby="p-praxis">
      <h3 id="p-praxis">Praxis</h3>
      <ProductShot id="praxis" size="card" />
      <p>{fr ? "Pipeline qui transforme une question business en note d’analyse sourcée, avec relecture adverse automatique." : "A pipeline that turns a business question into a sourced analysis note, with automatic adversarial review."}</p>
      <p class="figure-line"><Figure id="praxis.cost_per_briefing" where="card" text={fr ? undefined : "$3.29–4.75"} /> — {fr ? "par note produite" : "per note"}</p>
      <p class="limit"><span class="k">{t.limit}</span> {fr ? "Les" : "all"} <Figure id="praxis.insufficiently_sourced" where="card" defect text="6" /> {fr ? "notes publiées sont signalées insuffisamment sourcées par son propre contrôle." : "published notes are flagged as under-sourced by its own check."}</p>
      <p class="stack">{fr ? "TypeScript, Bun ; sorties Markdown, PDF, DOCX." : "TypeScript, Bun; Markdown, PDF and DOCX output."}</p>
      <p class="links"><a class="card-link" href={study("praxis")} aria-label={`${t.study} Praxis`}>{t.study}</a> · <a href={repo("praxis")}>Code</a></p>
    </article>
  </div>
</section>

<style>
  .projects {
    display: grid;
    gap: 2.5rem var(--gutter);
  }

  @media (min-width: 64rem) {
    .projects {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* A column: the links sit at the foot of each card, level across the row. */
  .project {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }

  .project .links {
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .project p {
    margin: 0.75rem 0 0;
  }

  /* The whole card opens its case study (.card, global.css). Blocks holding links of their own sit
     above the stretched link; the one under the pointer or the keyboard rises above its
     neighbours, so its proof tooltip is not drawn under the next line. */
  .project :global(figcaption),
  .figure-line,
  .limit,
  .links a:not(.card-link) {
    position: relative;
    z-index: 1;
  }

  .project :global(figcaption):is(:hover, :focus-within),
  .figure-line:is(:hover, :focus-within),
  .limit:is(:hover, :focus-within) {
    z-index: 2;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project:hover :global(.shot img) {
      transform: scale(1.02);
    }
  }

  .figure-line {
    font-size: var(--step-14);
  }

  /* The limit is the project's known defect: its label carries the defect colour, the text stays ink. */
  .limit {
    font-size: var(--step-14);
  }

  .limit .k {
    color: var(--defect);
    font-weight: 600;
  }

  .limit :global(.figure.defect) {
    color: var(--ink);
  }

  .stack {
    font-size: var(--step-14);
    color: var(--graphite);
  }

  .links {
    font-size: var(--step-14);
  }
</style>
