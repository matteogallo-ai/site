---
import { measure } from "../lib/measures.ts";

interface Props {
  id: string;
  /** Where the figure sits on the page: keeps element ids unique when a measure appears twice. */
  where: string;
  lang?: "fr" | "en";
  /** Defects are shown in the defect colour, at the same level as measures. */
  defect?: boolean;
}

const { id, where, lang = "fr", defect = false } = Astro.props;
const tip = `src-${where}-${id.replaceAll(".", "-")}`;
const m = measure(id);
// French puts a no-break space before the colon; the mono subset has U+00A0, not U+202F.
const proof = lang === "fr" ? "Preuve\u00A0:" : "Proof:";
---

<a class:list={["figure", { defect }]} href={m.url} aria-describedby={tip}>
  <span class="value mono">{m.display[lang]}</span>
  <span class="path mono" id={tip} role="tooltip">{proof} {m.repo.split("/")[1]}/{m.path}</span>
</a>

<script>
  // WCAG 1.4.13: content shown on hover or focus can be dismissed without moving either.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const figure of document.querySelectorAll<HTMLElement>(".figure:hover, .figure:focus-visible")) figure.dataset["dismissed"] = "";
  });
  for (const figure of document.querySelectorAll<HTMLElement>(".figure")) {
    const reset = () => delete figure.dataset["dismissed"];
    figure.addEventListener("blur", reset);
    figure.addEventListener("mouseleave", reset);
  }
</script>

<style>
  /* The tooltip is positioned against the figure's block (the cell, list item or paragraph
     that contains it), not the figure: it can then never be wider than that block, and a
     figure near the right edge cannot widen the page. */
  .figure {
    display: inline-block;
    color: var(--proof-text);
    text-decoration: none;
  }

  .figure.defect {
    color: var(--defect);
  }

  .value {
    font-variant-numeric: tabular-nums;
    border-bottom: 1px dotted currentColor;
  }

  /* The artefact path appears on hover and keyboard focus (SPEC §5.2). */
  .path {
    position: absolute;
    left: 0;
    top: calc(100% + 0.35rem);
    z-index: 2;
    width: max-content;
    max-width: 100%;
    padding: 0.3rem 0.5rem;
    font-size: var(--step-12);
    line-height: 1.4;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow-wrap: anywhere;
    /* display, not visibility: a hidden box would still widen the page on narrow screens. */
    display: none;
  }

  .figure:is(:hover, :focus-visible):not([data-dismissed]) .path {
    display: block;
  }
</style>
