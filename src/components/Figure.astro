---
import { langOf } from "../lib/i18n.ts";
import { measure, shownTextError } from "../lib/measures.ts";

interface Props {
  id: string;
  /** Where the figure sits on the page: keeps element ids unique when a measure appears twice. */
  where: string;
  /** Defects are shown in the defect colour, at the same level as measures. */
  defect?: boolean;
  /** Words to show instead of the value, such as "3" in a sentence; each number in them must be the measure's. */
  text?: string | undefined;
}

const { id, where, defect = false, text } = Astro.props;
const lang = langOf(Astro.url.pathname);
const tip = `src-${where}-${id.replaceAll(".", "-")}`;
const m = measure(id);
// French puts a no-break space before the colon; the mono subset has U+00A0, not U+202F.
const proof = lang === "fr" ? "Preuve\u00A0:" : "Proof:";
// Read aloud: the figure and what it counts, on a card or in a table; within a sentence
// the sentence already says it, and the value alone keeps the sentence whole; so do words shown in
// place of the value (`text`), which belong to their sentence. The proof path is
// the link's description only (aria-describedby).
const name = `${m.display[lang]}, ${m.label[lang]}`;
// A figure set in words ("12 of 40 findings") reads in the text face; a bare number in mono.
const shown = text ?? m.display[lang];
if (text !== undefined) {
  const error = shownTextError(m, text, lang);
  if (error) throw new Error(error);
}
---

<a class:list={["figure", "tip-host", { defect }]} href={m.url} data-id={id} data-where={where} data-in-sentence={where === "prose" || text !== undefined ? "" : undefined} aria-label={where === "prose" || text !== undefined ? undefined : name} aria-describedby={tip}>
  <span class:list={["value", { mono: text === undefined || !/\p{L}/u.test(text) }]}>{shown}</span>
  <span class="path tip mono" id={tip} role="tooltip">{proof} {m.repo.split("/")[1]}/{m.path}</span>
</a>

<script>
  import { dismissibleTips } from "../scripts/tips.ts";
  dismissibleTips();
</script>

<style>
  /* The artefact path appears on hover and keyboard focus (SPEC §5.2), as a .tip (global.css). */
  .figure {
    display: inline-block;
    /* A 24 px target (WCAG 2.5.8), also in the small type of the tables. */
    min-width: 24px;
    min-height: 24px;
    color: var(--proof-text);
    text-decoration: none;
  }

  .figure.defect {
    color: var(--defect);
  }

  /* In a sentence the line of text sets the target (WCAG 2.5.8 exempts it): a minimum width
     would open a hole after a short figure such as "3". */
  .figure[data-in-sentence] {
    min-width: 0;
  }

  .value {
    font-variant-numeric: tabular-nums;
    /* A thin solid rule and the ↗ after it (global.css): this figure opens its proof. */
    border-bottom: 1px solid currentColor;
  }

  /* Under the pointer or the keyboard the rule thickens, drawn below it: no line moves. */
  .figure:is(:hover, :focus-visible) .value {
    box-shadow: 0 1px 0 currentColor;
  }

</style>
