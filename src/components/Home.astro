---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Figure from "./Figure.astro";
import VerityDemo from "./VerityDemo.astro";
import Projects from "./Projects.astro";
import Bio from "./Bio.astro";
import LangSwitch from "./LangSwitch.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import { langOf } from "../lib/i18n.ts";
import portrait from "../assets/matteo.jpg";

const repo = (name: string) => `https://github.com/matteogallo-ai/${name}`;
// The home page in either language (src/pages/index.astro, src/pages/en/index.astro): one layout,
// one style sheet, the words of the page's language.
const fr = langOf(Astro.url.pathname) === "fr";
const id = fr ? { projects: "projets", method: "methode", about: "a-propos" } : { projects: "projects", method: "method", about: "about" };
---

<Base
  title={fr ? "Matteo Gallo — Ingénieur logiciel & IA" : "Matteo Gallo — Software & AI Engineer"}
  description={fr
    ? "Matteo Gallo, ingénieur logiciel et IA à Lausanne. Logiciels et systèmes d’IA conçus et mis en production de bout en bout, évalués et mesurés."
    : "Matteo Gallo, software and AI engineer in Lausanne. Software and AI systems designed and taken to production end to end, evaluated and measured."}
  serif
  stickyHeader
>
  <div class="bar" slot="header">
    <div class="pill glass glass-nav">
      <nav class="nav" aria-label={fr ? "Principale" : "Main"}>
        <ul>
          <li><a href={`#${id.projects}`}>{fr ? "Projets" : "Projects"}</a></li>
          <li><a href={`#${id.method}`}>{fr ? "Méthode" : "Method"}</a></li>
          <li><a href={`#${id.about}`}>{fr ? "À propos" : "About"}</a></li>
          <li class="spy" data-spy-dot hidden aria-hidden="true"></li>
        </ul>
      </nav>
      <span class="lang"><LangSwitch /></span>
    </div>
  </div>

  <section class="container hero" aria-labelledby="claim">
    <div class="intro">
      <div class="who">
        <Picture src={portrait} formats={["avif", "webp"]} width={56} height={56} densities={[1, 2]} alt={fr ? "Portrait de Matteo Gallo" : "Portrait of Matteo Gallo"} class="portrait" loading="eager" fetchpriority="high" />
        <p>
          <span class="name">Matteo Gallo</span>
          <span class="role">{fr ? "Ingénieur logiciel & IA · Lausanne" : "Software & AI Engineer · Lausanne"}</span>
          <span class="status"><span class="dot" aria-hidden="true"></span>{fr ? "Disponible" : "Available"}</span>
        </p>
      </div>
      <h1 id="claim">{fr ? "Je conçois des logiciels et des systèmes d’IA, de l’idée à la production." : "I build software and AI systems, from idea to production."}</h1>
      <p class="message">
        {fr ? "Ma spécialité : mesurer ce qu’ils valent vraiment. Tests, évaluations, limites publiées." : "My focus: measuring what they are actually worth. Tests, evaluations, published limits."}
      </p>
      <p class="actions">
        <a class="button primary" href={`#${id.projects}`}>{fr ? "Voir les projets" : "See the projects"}</a>
        <a class="button" href="#contact">{fr ? "Écrire un e-mail" : "Get in touch"}</a>
      </p>
    </div>
    <div class="stage">
      <VerityDemo />
    </div>
  </section>

  <Projects />

  <section class="container section reveal" id={id.method} aria-labelledby={`${id.method}-title`}>
    <p class="mono rule-label">+ 02</p>
    <h2 id={`${id.method}-title`}>{fr ? "Méthode" : "Method"}</h2>
    <ul class="rules">
      <li class="card">
        <h3>{fr ? "Audit indépendant" : "Independent audit"}</h3>
        <p>{fr ? "Audit à froid par un agent IA sans contexte. Sur PromptLang :" : "Cold audit by an AI agent with no prior context. On PromptLang:"} <Figure id="promptlang.audit_findings" where="method" /> {fr ? "constats, chacun corrigé, réfuté ou documenté." : "findings, each fixed, refuted or documented."}</p>
        <p class="links"><a href="https://github.com/matteogallo-ai/promptlang/pull/32">PR promptlang#32</a></p>
      </li>
      <li class="card">
        <h3>{fr ? "Lecture des sorties réelles" : "Reading real outputs"}</h3>
        <p>{fr ? "Les tests ne suffisent pas. La relecture d’un briefing Praxis a révélé des estimations présentées comme des faits ; le validateur a été corrigé." : "Tests are not enough. Reviewing a Praxis briefing revealed estimates presented as facts; the validator was fixed."}</p>
        <p class="links"><a href="https://github.com/matteogallo-ai/praxis/pull/47">PR praxis#47</a></p>
      </li>
      <li class="card">
        <h3>{fr ? "Évaluation pré-enregistrée" : "Pre-registered evaluation"}</h3>
        <p>{fr ? "Échantillon tiré avec une graine fixe et commité avant l’annotation. Le résultat est publié tel quel, même défavorable :" : "Sample drawn with a fixed seed and committed before annotation. The result is published as is, even when unfavourable:"} <Figure id="promptlang.linter_precision_reviewed" where="method" defect />.</p>
        <p class="links"><a href="https://github.com/matteogallo-ai/promptlang/pull/39">PR promptlang#39</a></p>
      </li>
    </ul>
    <p><a href={repo("how-i-build")}>{fr ? "Toutes les règles et leurs incidents : how-i-build" : "All the rules and their incidents: how-i-build"}</a></p>
  </section>

  <section class="container section closing reveal" id={id.about} aria-label={fr ? "À propos et contact" : "About and contact"}>
    <div class="about">
      <p class="mono rule-label">+ 03</p>
      <h2>{fr ? "À propos" : "About"}</h2>
      <Bio />
    </div>
    <Contact />
  </section>

  <script>
    import { spyOn } from "../scripts/spy.ts";
    import { revealOnSight } from "../scripts/reveal.ts";
    revealOnSight(document.querySelectorAll<HTMLElement>(".reveal"));
    const nav = document.querySelector<HTMLElement>(".nav");
    if (nav) spyOn(nav);
  </script>

  <Footer />
</Base>


<style>
  .bar {
    display: flex;
    justify-content: center;
    margin-top: 0.75rem;
    pointer-events: none;
  }

  .pill {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0 1rem;
    /* The links carry the pill's height: 44 px touch targets (WCAG 2.5.5). */
    padding: 0 1.1rem;
    font-size: var(--step-14);
    border-radius: 999px;
    box-shadow: 0 0 0 1px var(--glass-edge), 0 8px 24px -16px rgb(17 17 17 / 0.4);
    pointer-events: auto;
  }

  .nav ul {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The language selector closes the pill, set off from the section links by a rule. */
  .lang {
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  /* The underline draws itself from the left on hover; it stays drawn on the section in view. */
  .nav a,
  .lang :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .nav a {
    position: relative;
    text-decoration: none;
  }

  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    /* Under the text, not under the 44 px box. */
    bottom: calc(50% - 0.75em);
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-move) var(--ease-out);
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  /* The dot under the link of the section in view (src/scripts/spy.ts): it travels by
     translateX from the list's left edge, so only its transform moves. */
  .spy {
    position: absolute;
    left: -2px;
    bottom: 0.2rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--proof);
    transition: transform var(--dur-move) var(--ease-in-out);
  }

  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: 2.5rem 3rem;
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: 5fr 7fr;
      gap: var(--gutter) 3rem;
      align-items: center;
      padding-top: 1rem;
    }
  }

  /* Who, in small type: the claim below is the headline. */
  .who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .who :global(.portrait) {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    flex: none;
  }

  .who p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.1rem 0.75rem;
    margin: 0;
    font-size: var(--step-14);
  }

  .name {
    flex-basis: 100%;
    font-weight: 600;
  }

  .role,
  .status {
    color: var(--graphite);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--proof);
  }

  h1 {
    margin: 1.75rem 0 0;
    font-size: var(--step-44);
    line-height: 1.02;
    letter-spacing: var(--track-44);
    text-wrap: balance;
  }

  @media (min-width: 64rem) {
    h1 {
      font-size: var(--step-68);
      letter-spacing: var(--track-68);
    }
  }

  .message {
    margin: 1.25rem 0 0;
    font-size: var(--step-21);
    line-height: 1.45;
    color: var(--graphite);
    max-width: 30em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
  }

  figcaption {
    margin-top: 0.4rem;
    font-size: var(--step-12);
    color: var(--graphite);
  }

  .links {
    font-size: var(--step-14);
  }

  /* Three rules side by side: each a short claim, the incident behind it, its PR. */
  .rules {
    display: grid;
    gap: var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .rules {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rules li {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }

  /* The paragraph holding a figure sits above the stretched PR link (.card, global.css), so the
     figure keeps its own link and proof tooltip. */
  .rules li > p:has(> :global(.figure)) {
    z-index: 1;
  }

  .rules h3 {
    font-size: var(--step-21);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .rules p {
    margin: 0.6rem 0 0;
    font-size: var(--step-14);
    color: var(--graphite);
  }

  /* The PR link sits at the foot of each card, level across the row. It is the card's only link
     and it leaves the site, so it stays to its own words: a whole card that opened GitHub would
     look like a project card and lead elsewhere. */
  .rules .links {
    margin-top: auto;
    padding-top: 0.75rem;
  }

  /* About and contact close the page together: the bio on the left, the ask on the right. */
  .closing {
    display: grid;
    gap: 3rem var(--gutter);
  }

  @media (min-width: 64rem) {
    .closing {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .closing :global(.contact) {
      padding-top: 2.4rem;
    }
  }

</style>
