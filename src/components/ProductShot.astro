---
import { Picture } from "astro:assets";
import verityShot from "../assets/projects/verity-demo-110.png";
import promptlangStill from "../assets/projects/promptlang-demo-last.png";
import praxisPage from "../assets/projects/praxis-esg-brief-p1.png";
import media from "../data/media.json";
import { langOf } from "../lib/i18n.ts";

// A product's image, a one-line caption and the link to the recording or the PDF it comes from:
// on the home page's card, where the image belongs to the card's link to the case study, and
// large after a case study's brief, where the image itself opens the recording or the PDF. What
// the image shows in detail is its alt text.
interface Props {
  id: "verity" | "promptlang" | "praxis";
  /** "card": a third of the page at most; "lead": the head of a case study. */
  size: "card" | "lead";
}

const { id, size } = Astro.props;
const lang = langOf(Astro.url.pathname);
const images = { verity: verityShot, promptlang: promptlangStill, praxis: praxisPage };
const item = media.media.find((m) => m.id === id);
if (!item) throw new Error(`no media for ${id}`);
const link = {
  fr: { gif: "Voir le GIF", pdf: "Voir le PDF" },
  en: { gif: "See the GIF", pdf: "See the PDF" },
}[lang][item.url.endsWith(".pdf") ? "pdf" : "gif"];
// 412 px at 1.75x asks for 721 px: without 960 a phone would get the 1440 file.
const widths = size === "card" ? [480, 960] : [480, 720, 960, 1440];
const sizes = size === "card" ? "(min-width: 64rem) 360px, 100vw" : "(min-width: 64rem) 720px, 100vw";
---

<figure class:list={["shot", size]}>
  {
    size === "lead" ? (
      <a class="open" href={item.url}>
        <Picture src={images[id]} formats={["avif", "webp"]} alt={item.alt[lang]} widths={widths} sizes={sizes} loading="eager" decoding="async" />
      </a>
    ) : (
      <Picture src={images[id]} formats={["avif", "webp"]} alt={item.alt[lang]} widths={widths} sizes={sizes} loading="lazy" decoding="async" />
    )
  }
  <figcaption>{item.caption[lang]} <a href={item.url}>{link}</a></figcaption>
</figure>

<style>
  .shot {
    margin: 1rem 0 0;
  }

  .shot.lead {
    max-width: 45rem;
    margin-top: 2rem;
  }

  /* The picture clips its image, so the image can zoom under the pointer within its frame. */
  .shot :global(picture) {
    display: block;
    overflow: hidden;
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--rule);
  }

  /* One frame for the three images, the Verity screenshot's own ratio: the others show their
     top (the briefing's first page is a portrait A4 sheet, its title and verdict at the top). */
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    transition: transform var(--dur-image) var(--ease-out);
  }

  /* The image opens what it was taken from: no ↗ drawn after it, the caption's link says where. */
  .open {
    display: block;
    padding: 0;
  }

  .open::after {
    content: none !important;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--graphite);
  }
</style>
