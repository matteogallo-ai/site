---
import { langOf } from "../../lib/i18n.ts";

/** The full measures tables, folded: the section's prose carries the reading, the tables the detail. */
const lang = langOf(Astro.url.pathname);
---

<details class="measures-detail">
  {
    lang === "fr" ? (
      <>
        <summary>Détail des mesures</summary>
        <p class="ci-note">
          Une proportion porte son intervalle de confiance à <span class="ci-level">95&nbsp;%</span> (IC) : la plage où se trouve probablement la vraie valeur, large quand l’échantillon est petit. Ses bornes sont arrondies au pour cent entier vers l’extérieur : elles peuvent dépasser d’un point celles du fichier source.
        </p>
      </>
    ) : (
      <>
        <summary>Results in detail</summary>
        <p class="ci-note">
          A proportion carries its <span class="ci-level">95%</span> confidence interval (CI): the range where the true value probably lies, wide when the sample is small. Its bounds are rounded outwards to whole percents: they may exceed the source file’s by one point.
        </p>
      </>
    )
  }
  <slot />
</details>

<style>
  /* Wider than the prose for its tables, but held to a width where a row still reads as one. */
  .measures-detail {
    max-width: 64rem;
    margin-top: 2rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding-block: 0.75rem;
  }

  /* The summary reads as a link: its underline takes the full colour under the pointer. */
  summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-hover) var(--ease-out);
  }

  summary:hover {
    text-decoration-color: currentColor;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* The content's height travels where the engine can interpolate to auto (Chromium); elsewhere
     it opens at once. content-visibility is held until the fold has closed (allow-discrete). */
  .measures-detail {
    interpolate-size: allow-keywords;
  }

  .measures-detail::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size var(--dur-move) var(--ease-in-out),
      content-visibility var(--dur-move) allow-discrete;
  }

  .measures-detail[open]::details-content {
    block-size: auto;
  }

  /* Prose in the fold keeps the reading measure of the sections' text. */
  .ci-note,
  .measures-detail > :global(p) {
    max-width: 34rem;
  }

  .ci-note {
    margin-top: 1rem;
  }

  /* The native marker is a triangle the sans subset does not have: a "+" it has, turned into a
     "×" by turning it 45° when the fold is open. */
  summary::before {
    content: "+";
    display: inline-block;
    margin-right: 0.4em;
    font-family: var(--font-mono);
    /* The mono subset ships one weight: the bold summary would ask for a face that is not there. */
    font-weight: 400;
    transition: transform var(--dur-move) var(--ease-in-out);
  }

  details[open] > summary::before {
    transform: rotate(45deg);
  }
</style>
