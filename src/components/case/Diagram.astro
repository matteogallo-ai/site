---
import { layout, type Node, TEXT, WIDTH } from "../../lib/diagram.ts";

interface Props {
  /** Unique on the page: names the title and description the SVG is labelled by. */
  id: string;
  title: string;
  steps: Node[];
  outcomes?: Node[];
  caption: string;
}

const { id, title, steps, outcomes = [], caption } = Astro.props;
const d = layout({ steps, outcomes });
// The SVG is one image to assistive technology: its description is the diagram read in order.
const read = (n: Node) => [n.title, ...(n.lines ?? [])].join(", ");
const desc = `${steps.map(read).join(". Puis : ")}.${outcomes.length ? ` Issues : ${outcomes.map(read).join(" ; ")}.` : ""}`;
const points = (p: [number, number][]) => p.map(([x, y]) => `${x},${y}`).join(" ");
---

<figure class="diagram">
  <svg viewBox={`0 0 ${WIDTH} ${d.height}`} width={WIDTH} height={d.height} role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>{title}</title>
    <desc id={`${id}-d`}>{desc}</desc>
    <defs>
      <marker id={`${id}-head`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0,0 L8,4 L0,8 z" class="head"></path>
      </marker>
    </defs>
    {d.arrows.map((a) => <polyline points={points(a)} class="arrow" marker-end={`url(#${id}-head)`} />)}
    {
      d.boxes.map((b) => (
        <g class:list={["node", b.tone]}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="6" />
          <text x={b.x + TEXT.padX} y={b.baselines[0]} class="title" font-size={TEXT.titleSize}>
            {b.title}
          </text>
          {(b.lines ?? []).map((line, i) => (
            <text x={b.x + TEXT.padX} y={b.baselines[i + 1]} class="line" font-size={TEXT.lineSize}>
              {line}
            </text>
          ))}
        </g>
      ))
    }
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .diagram {
    margin: 1.5rem 0 0;
  }

  svg {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    font-family: var(--font-sans);
  }

  rect {
    fill: var(--paper);
    stroke: var(--graphite);
    stroke-width: 1;
  }

  .proof rect {
    stroke: var(--proof);
    stroke-width: 1.5;
  }

  .defect rect {
    stroke: var(--defect);
    stroke-width: 1.5;
  }

  .title {
    fill: var(--ink);
    font-weight: 600;
  }

  .proof .title {
    fill: var(--proof-text);
  }

  .defect .title {
    fill: var(--defect);
  }

  .line {
    fill: var(--graphite);
  }

  .arrow {
    fill: none;
    stroke: var(--graphite);
    stroke-width: 1.25;
  }

  .head {
    fill: var(--graphite);
  }

  figcaption {
    margin-top: 0.75rem;
    max-width: 34em;
    font-size: var(--step-14);
    color: var(--graphite);
  }
</style>
