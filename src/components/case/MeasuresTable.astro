---
import Figure from "../Figure.astro";
import { interval, measure } from "../../lib/measures.ts";

/**
 * One measure per row, optionally beside the same measure on a baseline. Every figure is a
 * Figure (linked to its artefact); every interval is read from the measure. A measure with no
 * interval must say why in `noInterval`, and one with an interval may not: the build fails
 * either way, so a missing interval is never silent.
 */
interface Row {
  id: string;
  /**
   * Row label in place of the measure's own: when that label names its arm ("… — Verity"), or uses
   * words a non-specialist reader would have to look up. The test compares a row's label with its
   * measure only when this is absent.
   */
  label?: string;
  base?: string;
  noInterval?: string;
  defect?: boolean;
  reading: string;
}

interface Props {
  /** Unique on the page: keeps Figure tooltip ids unique. */
  where: string;
  caption: string;
  ours?: string;
  baseline?: string;
  rows: Row[];
}

const { where, caption, ours = "Valeur", baseline, rows } = Astro.props;

const ci = (id: string, noInterval?: string) => {
  const m = measure(id);
  if (m.ci95 && noInterval) throw new Error(`${id} has an interval: drop noInterval`);
  if (!m.ci95 && !noInterval) throw new Error(`${id} has no interval: say why in noInterval`);
  return m.ci95 ? { text: interval(m), measured: true } : { text: noInterval!, measured: false };
};
const cells = rows.map((r) => {
  if (baseline && !r.base) throw new Error(`${r.id}: a comparison row needs its baseline measure`);
  if (r.base && !baseline) throw new Error(`${r.id}: a baseline measure needs the table's baseline column`);
  return { ...r, ownLabel: !r.label, label: r.label ?? measure(r.id).label.fr, ci: ci(r.id, r.noInterval), baseCi: r.base ? ci(r.base) : undefined };
});
---

<h3 class="caption" id={`${where}-caption`}>{caption}</h3>
{/* Explicit roles: the narrow-screen cards set display: block, which makes some engines drop table semantics. */}
<table role="table" aria-labelledby={`${where}-caption`}>
  <thead role="rowgroup">
    <tr role="row">
      <th scope="col" role="columnheader">Mesure</th>
      <th scope="col" role="columnheader">{ours}</th>
      <th scope="col" role="columnheader" class="ci-level">IC 95&nbsp;%</th>
      {baseline && <th scope="col" role="columnheader">{baseline}</th>}
      {baseline && <th scope="col" role="columnheader" class="ci-level">IC 95&nbsp;%</th>}
      <th scope="col" role="columnheader">Lecture</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {
      cells.map((r) => (
        <tr role="row">
          <th scope="row" role="rowheader" data-label={r.ownLabel ? r.id : undefined}>
            {r.label}
          </th>
          <td role="cell" class="value" data-col={ours}>
            <Figure id={r.id} where={where} defect={r.defect ?? false} />
          </td>
          <td role="cell" class:list={["ci", { reason: !r.ci.measured }]} data-col="IC 95 %" data-measure={r.ci.measured ? r.id : undefined}>
            {r.ci.text}
          </td>
          {r.base && (
            <td role="cell" class="value" data-col={baseline}>
              <Figure id={r.base} where={where} />
            </td>
          )}
          {r.base && (
            <td role="cell" class="ci" data-col="IC 95 %" data-measure={r.base}>
              {r.baseCi!.text}
            </td>
          )}
          <td role="cell" class="reading" data-col="Lecture">
            {r.reading}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .caption {
    margin-top: 2rem;
    font-size: var(--step-16);
  }

  table {
    width: 100%;
    margin-top: 0.75rem;
    border-collapse: collapse;
    font-size: var(--step-14);
  }

  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.6rem 0.75rem 0.6rem 0;
    border-top: 1px solid var(--rule);
  }

  thead th {
    font-weight: 400;
    font-size: var(--step-12);
    color: var(--graphite);
    border-top: 0;
  }

  tbody th {
    font-weight: 400;
    max-width: 16rem;
  }

  /* The cell anchors the proof tooltip of its Figure (src/components/Figure.astro). */
  .value {
    position: relative;
    white-space: nowrap;
  }

  .ci {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .ci.reason {
    white-space: normal;
    color: var(--graphite);
    min-width: 10rem;
  }

  .reading {
    color: var(--graphite);
    min-width: 14rem;
  }

  /* Narrow screens: each row becomes a card, each cell names its column, nothing scrolls sideways. */
  @media (max-width: 47.99rem) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    table,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    tr {
      padding-block: 0.75rem;
      border-top: 1px solid var(--rule);
    }

    th,
    td {
      border-top: 0;
      padding: 0.2rem 0;
      max-width: none;
      min-width: 0;
    }

    .value,
    .ci,
    .ci.reason,
    .reading {
      min-width: 0;
      white-space: normal;
    }

    tbody th {
      font-weight: 600;
    }

    /* Seen, not announced: the cell's role already gives a screen reader its column header. */
    td[data-col]::before {
      content: attr(data-col) " : ";
      content: attr(data-col) " : " / "";
      color: var(--graphite);
      font-size: var(--step-12);
    }
  }
</style>
