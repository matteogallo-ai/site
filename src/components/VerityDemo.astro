---
import sla from "../data/demo/sla.json";
import answerData from "../data/demo/answer.json";
import refusalData from "../data/demo/refusal.json";
import type { DemoTrace } from "../../scripts/traces-lib.ts";
import { firstListIn, toBlocks, type Span } from "../lib/document.ts";
import { decimal } from "../lib/measures.ts";

const answer = answerData as DemoTrace;
const refusal = refusalData as DemoTrace;
const slaPath = sla.source.path;
const slaId = Object.entries(answer.documents).find(([, path]) => path === slaPath)![0];

// The quote the spotlight goes to is the citation on the page's document; the other one is a reference.
const cited = answer.citations.find((c) => c.document_id === slaId)!;
const elsewhere = answer.citations.filter((c) => c.document_id !== slaId);
const closest = refusal.hits_used[0]!.chunk;
const refusalTarget = firstListIn(sla.text, closest);

// The card states these checks as passed: a trace that fails them must not build.
if (sla.text.slice(cited.char_start, cited.char_end) !== cited.quote) throw new Error(`${answer.example_id}: the quote is not at its offsets in ${slaPath}`);
const claims = answer.judge_claims ?? [];
if (claims.length === 0) throw new Error(`${answer.example_id}: no judge claims to report`);
const supported = claims.filter((c) => c.supported && c.citation_ok).length;

const blocks = toBlocks(sla.text, [
  { name: "answer", start: cited.char_start, end: cited.char_end },
  { name: "refusal", ...refusalTarget },
]);

const sectionOf = (section: string) => section.split(" > ").at(-1)!;
const fileOf = (path: string) => path.split("/").at(-1)!;
const chunkOf = (chunkId: string) => answer.hits_used.find((h) => h.chunk.id === chunkId)?.chunk;
const runFile = fileOf(answer.source.path);
---

<div class="demo" data-verity-demo data-mode="answer">
  <div class="tabs" role="tablist" aria-label="Mode de Verity">
    <button type="button" role="tab" id="verity-tab-answer" aria-controls="verity-panel-answer" aria-selected="true" data-mode="answer">Répond, en citant</button>
    <button type="button" role="tab" id="verity-tab-refusal" aria-controls="verity-panel-refusal" aria-selected="false" tabindex="-1" data-mode="refusal">Refuse, faute de preuve</button>
  </div>

  <div class="window">
    <div class="sheet" data-sheet tabindex="0" role="region" aria-label="Contrat de démonstration : Service Level Agreement">
    <article class="doc serif" lang="en">
      {
        blocks.map((b) =>
          b.kind === "ul" ? (
            <ul>
              {b.items.map((item) => (
                <li>
                  {item.map((s: Span) => (
                    <span data-o={s.start} data-mark={s.marks.join(" ") || undefined}>{s.text}</span>
                  ))}
                </li>
              ))}
            </ul>
          ) : (
            <p class={b.kind === "p" ? undefined : `heading ${b.kind}`}>
              {b.spans.map((s: Span) => (
                <span data-o={s.start} data-mark={s.marks.join(" ") || undefined}>{s.text}</span>
              ))}
            </p>
          ),
        )
      }
    </article>
    <div class="lens" data-lens hidden aria-hidden="true"><div class="ring glass"></div></div>
    <p class="lens-tag" data-lens-tag hidden aria-hidden="true">
      <span class="n">2</span><span data-tag-answer>Le passage retrouvé dans le contrat</span><span data-tag-refusal>Le passage le plus proche, jugé insuffisant</span>
    </p>
    </div>
  </div>

  <section class="card glass" role="tabpanel" id="verity-panel-answer" aria-labelledby="verity-tab-answer" tabindex="0">
    <p class="k">Question · {answer.example_id}</p>
    <p class="q" lang="en">{answer.question}</p>
    <p class="k">Réponse</p>
    <p class="a" lang="en"><span class="a-text">{answer.answer_text}</span></p>
    <blockquote class="serif" lang="en">{cited.quote}</blockquote>
    <p class="ref mono" lang="en">{fileOf(slaPath)} · {sectionOf(chunkOf(cited.chunk_id)!.section)}</p>
    {
      elsewhere.map((c) => (
        <p class="ref mono" lang="en">
          + {fileOf(answer.documents[c.document_id]!)} · {sectionOf(chunkOf(c.chunk_id)!.section)}
        </p>
      ))
    }
    <ul class="checks">
      <li><span class="tick mono" aria-hidden="true">✓</span> Citation retrouvée mot pour mot dans le document</li>
      <li>
        <span class="tick mono" aria-hidden="true">{supported === claims.length ? "✓" : "✗"}</span>
        <span class="mono">{supported}/{claims.length}</span> affirmations étayées par leur citation, selon le juge
      </li>
      <li><span class="tick mono muted" aria-hidden="true">·</span> confiance <span class="mono">{decimal(answer.confidence_score, 2, "fr")}</span></li>
    </ul>
  </section>

  <section class="card glass refused" role="tabpanel" id="verity-panel-refusal" aria-labelledby="verity-tab-refusal" tabindex="0" hidden>
    <p class="k">Question · {refusal.example_id}</p>
    <p class="q" lang="en">{refusal.question}</p>
    <p class="k">Réponse</p>
    <p class="a" lang="en"><span class="a-text">{refusal.answer_text}</span></p>
    <p class="verdict">Refus du modèle · confiance <span class="mono">{decimal(refusal.confidence_score, 2, "fr")}</span></p>
    <p class="ref">Passage le plus proche{"\u00A0"}: <span class="mono" lang="en">{fileOf(slaPath)} · {sectionOf(closest.section)}</span>, jugé insuffisant</p>
    <p class="why" lang="en">{refusal.refusal_rationale}</p>
  </section>

  <p class="source mono">
    <a href={sla.source.url}>{fileOf(slaPath)}</a> · run <a href={answer.source.url}>{runFile}</a>
  </p>
</div>

<noscript>
  <style is:inline>
    /* Without the script the tabs cannot switch: show both cards and no inert controls. */
    [data-verity-demo] .tabs {
      visibility: hidden;
    }
    #verity-panel-refusal[hidden] {
      display: block;
      margin-top: 1rem;
    }
    /* Nothing scrolls the window to the passage: the whole contract is shown, the cards below it. */
    [data-verity-demo] [data-sheet] {
      height: auto;
      padding-bottom: 1.25rem;
      mask-image: none;
    }
    [data-verity-demo] .card {
      margin: 1rem 0 0;
    }
  </style>
</noscript>

<script>
  import { mountVerityDemo } from "../scripts/verity-demo.ts";
  for (const root of document.querySelectorAll<HTMLElement>("[data-verity-demo]")) mountVerityDemo(root);
</script>

<style>
  .demo {
    position: relative;
  }

  .tabs {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    margin-bottom: 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  [role="tab"] {
    font-size: var(--step-14);
    padding: 0.4rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--graphite);
    cursor: pointer;
  }

  [role="tab"][aria-selected="true"] {
    background: var(--ink);
    color: var(--paper);
  }

  /* The contract is seen through a window of fixed height, scrolled to the passage in play
     (verity-demo.ts); it fades out at both ends to say that it goes on. */
  .window {
    background: var(--sheet);
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--rule), 0 12px 32px -18px rgb(17 17 17 / 0.35);
  }

  .sheet {
    position: relative;
    height: 18rem;
    padding: 1.5rem 1.5rem 1.25rem;
    overflow-y: auto;
    scrollbar-width: none;
    border-radius: inherit;
    /* Read by verity-demo.ts: where the passage goes, and what the tag above the lens keeps clear of. */
    --target-at: 0.5;
    --fade: 40px;
    --tag-gap: 14px;
    mask-image: linear-gradient(to bottom, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
  }

  /* The mask would also fade a focus outline drawn by the sheet: the window draws it, where
     the browser can select it. */
  @supports selector(:has(*)) {
    .sheet:focus-visible {
      outline: none;
    }

    .window:has(.sheet:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }
  }

  .doc {
    font-size: var(--step-14);
    line-height: 1.55;
    color: var(--ink);
  }

  /* The contract's own headings are not the page's: styled paragraphs keep the page outline. */
  .doc .heading {
    margin: 1rem 0 0.25rem;
    font-size: var(--step-14);
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: 0;
  }

  .doc .h1 {
    margin-top: 0;
    font-size: var(--step-16);
  }

  .doc p:not(.heading) {
    margin: 0 0 0.5rem;
  }

  .doc ul {
    margin: 0 0 0.5rem;
    padding-left: 1.1rem;
    /* The serif subset has no bullet (U+2022); the source document marks items with a hyphen. */
    list-style-type: "–\00A0";
  }

  /* Spotlight: once the script runs, the contract steps back and the passage in play keeps the
     ink. --dimmed still meets AA on the sheet (contrast.test.ts): the words around stay legible. */
  .demo[data-lit] .doc {
    color: var(--dimmed);
  }

  .doc [data-o] {
    transition: color var(--dur-slow) var(--ease);
  }

  /* Highlight follows the mode; the spans were cut at the cited offsets at build time. */
  .demo[data-mode="answer"] [data-mark~="answer"] {
    color: var(--ink);
    background: var(--proof-wash);
    box-shadow: 0 2px 0 var(--proof);
  }

  .demo[data-mode="refusal"] [data-mark~="refusal"] {
    color: var(--ink);
    background: var(--defect-wash);
    box-shadow: 0 2px 0 var(--defect);
  }

  /* The lens box holds the passage; its glass ring is drawn --ring wide outside it. */
  .lens {
    --ring: 7px;
    position: absolute;
    left: 0;
    top: 0;
    box-sizing: content-box;
    margin: calc(-1 * var(--ring));
    padding: var(--ring);
    border-radius: 16px;
    box-shadow: 0 14px 30px -18px rgb(17 17 17 / 0.5);
    transition:
      left var(--dur-slow) var(--ease),
      top var(--dur-slow) var(--ease),
      width var(--dur-slow) var(--ease),
      height var(--dur-slow) var(--ease);
    pointer-events: none;
  }

  /* Glass only in the ring: the mask cuts out the middle, so the passage stays sharp while the
     ring bends and frosts the dimmed lines around it (.glass, global.css). */
  .ring {
    position: absolute;
    inset: 0;
    padding: var(--ring);
    border: 1px solid var(--glass-edge);
    border-radius: inherit;
    mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
    mask-clip: content-box, border-box;
    mask-composite: exclude;
  }

  /* Above the lens, never over the passage. */
  .lens-tag {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    transform: translate(-100%, calc(-100% - var(--tag-gap)));
    padding: 0.15rem 0.55rem 0.15rem 0.2rem;
    box-shadow: 0 0 0 1px var(--rule);
    transition:
      left var(--dur-slow) var(--ease),
      top var(--dur-slow) var(--ease);
    font-size: var(--step-12);
    white-space: nowrap;
    color: var(--ink);
    background: var(--paper);
    border-radius: 999px;
  }

  .demo[data-mode="answer"] [data-tag-refusal],
  .demo[data-mode="refusal"] [data-tag-answer] {
    display: none;
  }

  .source {
    margin: 0.75rem 0 0;
    font-size: var(--step-12);
    color: var(--graphite);
    overflow-wrap: anywhere;
  }

  .source a {
    color: inherit;
  }

  /* Over the contract, the card's glass is near-opaque: its text then never sits on the words
     behind it (worst case checked in contrast.test.ts). */
  .card {
    margin-top: 1rem;
    padding: 1.25rem;
    background: var(--card-fill);
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--glass-edge), 0 12px 32px -20px rgb(17 17 17 / 0.4);
  }

  /* Motion only answers a change of mode: on load the card is simply there. */
  .demo[data-switched] .card {
    animation: card-in var(--dur-slow) var(--ease);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .card p {
    margin: 0;
  }

  .k {
    margin-top: 0.75rem !important;
    font-size: var(--step-12);
    color: var(--graphite);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .k:first-child {
    margin-top: 0 !important;
  }

  .q,
  .a {
    font-size: var(--step-16);
  }

  blockquote {
    margin: 0.75rem 0 0.25rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--proof);
    font-size: var(--step-16);
  }

  .ref {
    font-size: var(--step-12);
    color: var(--graphite);
    overflow-wrap: anywhere;
  }

  .checks {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-14);
  }

  /* The answer writes itself (verity-demo.ts) in an aria-hidden layer over the answer, which
     is only made transparent: assistive tech keeps the whole answer and the checks throughout. */
  .a {
    position: relative;
  }

  .a :global(.a-layer) {
    position: absolute;
    inset: 0;
  }

  .a :global(.unwritten) {
    visibility: hidden;
  }

  .card[data-writing] .a-text,
  .card[data-writing] .checks li {
    opacity: 0;
  }

  .card[data-written] .checks li {
    animation: card-in var(--dur-base) var(--ease) backwards;
  }

  .checks li:nth-child(2) {
    animation-delay: 120ms;
  }

  .checks li:nth-child(3) {
    animation-delay: 240ms;
  }

  .tick {
    display: inline-block;
    width: 1.1em;
    color: var(--proof-text);
  }

  .tick.muted {
    color: var(--graphite);
  }

  .verdict {
    margin-top: 0.75rem !important;
    color: var(--defect);
    font-weight: 600;
  }

  .why {
    margin-top: 0.5rem !important;
    font-size: var(--step-14);
    color: var(--graphite);
  }

  /* Wide screens: the answer card overlaps the bottom right of the window, so the question,
     its passage in the spotlight and the answer fit on the first screen together. */
  @media (min-width: 64rem) {
    /* The card covers the lower half of the window: the passage is centred in the upper part,
       and the padding lets the end of the contract scroll up there too. */
    .sheet {
      height: 22.5rem;
      padding-bottom: 12rem;
      /* Wide screens only: on a phone the window spans the screen, and a swipe on it must still
         scroll the page once the window is at its end. */
      overscroll-behavior: contain;
      --target-at: 0.27;
    }

    .window {
      margin-right: 12%;
    }

    .card {
      position: relative;
      z-index: 1;
      margin: -11.5rem 0 0 20%;
      padding: 1rem 1.25rem;
    }

    .q,
    .a,
    blockquote {
      font-size: var(--step-14);
    }

    .k {
      margin-top: 0.5rem !important;
    }
  }
</style>
