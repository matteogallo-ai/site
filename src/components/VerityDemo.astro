---
import sla from "../data/demo/sla.json";
import answerData from "../data/demo/answer.json";
import refusalData from "../data/demo/refusal.json";
import translationsData from "../data/demo/translations.json";
import { type DemoTrace, type DemoTranslations, sectionAt, translationErrors } from "../../scripts/traces-lib.ts";
import { firstListIn, toBlocks, type Span } from "../lib/document.ts";
import { langOf } from "../lib/i18n.ts";
import { decimal } from "../lib/measures.ts";

const answer = answerData as DemoTrace;
const refusal = refusalData as DemoTrace;
const slaPath = sla.source.path;
const slaId = Object.entries(answer.documents).find(([, path]) => path === slaPath)![0];

// The quote the spotlight goes to is the citation on the page's document; the other one is a reference.
const cited = answer.citations.find((c) => c.document_id === slaId)!;
const elsewhere = answer.citations.filter((c) => c.document_id !== slaId);
const closest = refusal.hits_used[0]!.chunk;
const refusalTarget = firstListIn(sla.text, closest);

// The card states these checks as passed: a trace that fails them must not build.
if (sla.text.slice(cited.char_start, cited.char_end) !== cited.quote) throw new Error(`${answer.example_id}: the quote is not at its offsets in ${slaPath}`);
const claims = answer.judge_claims ?? [];
if (claims.length === 0) throw new Error(`${answer.example_id}: no judge claims to report`);
const supported = claims.filter((c) => c.supported && c.citation_ok).length;

const blocks = toBlocks(sla.text, [
  { name: "answer", start: cited.char_start, end: cited.char_end },
  { name: "refusal", ...refusalTarget },
]);

const fileOf = (path: string) => path.split("/").at(-1)!;
const chunkOf = (chunkId: string) => answer.hits_used.find((h) => h.chunk.id === chunkId)?.chunk;
const runFile = fileOf(answer.source.path);
if (refusal.source.url !== answer.source.url) throw new Error("the two demo traces come from different runs: one source link cannot name both");

// The French lines translate exactly what each trace says (scripts/traces-lib.ts).
const translations = translationsData as DemoTranslations;
const untranslated = [...translationErrors(answer, translations), ...translationErrors(refusal, translations)];
if (untranslated.length > 0) throw new Error(untranslated.join("\n"));
const translation = (trace: DemoTrace) => translations[trace.example_id] as { question: { fr: string }; answer: { fr: string }; rationale?: { en: string; fr: string } };

// The traces are in English: the English page shows them without translation lines, and the
// refusal's rationale in the trace's own words. data-verbatim keeps the build's typography off
// the trace and the contract: they ship exactly as the committed run wrote them.
const lang = langOf(Astro.url.pathname);
const t = {
  fr: {
    caption: "Exécution réelle rejouée : Verity, mon agent RAG, contrat de test en anglais",
    modes: "Mode de Verity",
    answers: "Répond, en citant",
    refuses: "Refuse, faute de preuve",
    answersShort: "Répond",
    refusesShort: "Refuse",
    sheet: "Contrat de démonstration : Service Level Agreement",
    tagAnswer: "Le passage retrouvé dans le contrat",
    tagRefusal: "Le passage le plus proche, jugé insuffisant",
    question: "La question",
    verified: "La réponse, vérifiée",
    cited: "Cité\u00A0:",
    section: "section",
    found: "Citation retrouvée mot pour mot dans le document",
    claims: "affirmations étayées par leur citation, selon le juge",
    confidence: "confiance",
    refused: "La réponse : un refus, vérifié",
    verdict: "Refus du modèle, confiance",
    closest: "Passage le plus proche\u00A0:",
    insufficient: "jugé insuffisant",
    source: "Exécution de référence",
    run: "Exécution",
    ofVerity: "de Verity (questions",
    and: "et",
    contract: "), sur le contrat",
    names: { "sla.md": "contrat SLA", "order_form_northwind_2025.pdf": "bon de commande Northwind" } as Record<string, string>,
  },
  en: {
    caption: "Replay of a real run: Verity, my RAG agent, on a test contract",
    modes: "Verity's mode",
    answers: "Answers, citing",
    refuses: "Refuses, for lack of evidence",
    answersShort: "Answers",
    refusesShort: "Refuses",
    sheet: "Demo contract: Service Level Agreement",
    tagAnswer: "The passage found in the contract",
    tagRefusal: "The closest passage, judged insufficient",
    question: "The question",
    verified: "The answer, verified",
    cited: "Cited:",
    section: "section",
    found: "Quote found word for word in the document",
    claims: "claims supported by their quote, according to the judge",
    confidence: "confidence",
    refused: "The answer: a refusal, verified",
    verdict: "Refused by the model, confidence",
    closest: "Closest passage:",
    insufficient: "judged insufficient",
    source: "Reference run",
    run: "Run",
    ofVerity: "of Verity (questions",
    and: "and",
    contract: "), on the contract",
    names: { "sla.md": "SLA contract", "order_form_northwind_2025.pdf": "Northwind order form" } as Record<string, string>,
  },
}[lang];

// Readers get what a cited document is, not its file name; an unnamed document fails the build.
const nameOf = (path: string) => {
  const name = t.names[fileOf(path)];
  if (!name) throw new Error(`no reader-facing name for ${path}`);
  return name;
};
---

<div class="demo" data-verity-demo data-mode="answer">
  <div class="head">
  <p class="caption">{t.caption}</p>
  <div class="tabs segmented" role="tablist" aria-label={t.modes} data-at="0">
    <button type="button" role="tab" id="verity-tab-answer" aria-controls="verity-panel-answer" aria-selected="true" data-mode="answer" aria-label={t.answers}><span class="long">{t.answers}</span><span class="short">{t.answersShort}</span></button>
    <button type="button" role="tab" id="verity-tab-refusal" aria-controls="verity-panel-refusal" aria-selected="false" tabindex="-1" data-mode="refusal" aria-label={t.refuses}><span class="long">{t.refuses}</span><span class="short">{t.refusesShort}</span></button>
  </div>
  </div>

  <div class="window">
    <div class="sheet" data-sheet tabindex="0" role="region" aria-label={t.sheet}>
    <article class="doc serif" lang="en" data-verbatim>
      {
        blocks.map((b) =>
          b.kind === "ul" ? (
            <ul data-holds={b.items.some((item) => item.some((s: Span) => s.marks.includes("refusal"))) ? "refusal" : undefined}>
              {b.items.map((item) => (
                <li data-holds={item.some((s: Span) => s.marks.includes("answer")) ? "answer" : undefined}>
                  {item.map((s: Span) => (
                    <span data-o={s.start} data-mark={s.marks.join(" ") || undefined}>{s.text}</span>
                  ))}
                </li>
              ))}
            </ul>
          ) : (
            <p class={b.kind === "p" ? undefined : `heading ${b.kind}`} data-holds={b.spans.some((s: Span) => s.marks.includes("answer")) ? "answer" : undefined}>
              {b.spans.map((s: Span) => (
                <span data-o={s.start} data-mark={s.marks.join(" ") || undefined}>{s.text}</span>
              ))}
            </p>
          ),
        )
      }
    </article>
    <div class="lens" data-lens hidden aria-hidden="true"><div class="ring glass"></div></div>
    <p class="lens-tag" data-lens-tag hidden aria-hidden="true">
      <span class="n">2</span><span data-tag-answer>{t.tagAnswer}</span><span data-tag-refusal>{t.tagRefusal}</span>
    </p>
    </div>
  </div>

  <div class="cards">
  <section class="card glass" role="tabpanel" id="verity-panel-answer" aria-labelledby="verity-tab-answer" tabindex="0">
    <p class="step"><span class="n">1</span> {t.question}</p>
    <p class="q" lang="en" data-verbatim>{answer.question}</p>
    {lang === "fr" && <p class="tr"><span class="tr-k">traduction</span> {translation(answer).question.fr}</p>}
    <p class="step"><span class="n">3</span> {t.verified}</p>
    <p class="a" lang="en" data-verbatim><span class="a-text">{answer.answer_text}</span></p>
    {lang === "fr" && <p class="tr tr-a"><span class="tr-k">traduction</span> {translation(answer).answer.fr}</p>}
    <p class="ref">
      {/* Each quote is placed by the section that holds it, not by the section its chunk starts in. */}
      {t.cited} {[cited, ...elsewhere].map((c) => `${nameOf(answer.documents[c.document_id]!)} (${t.section} ${sectionAt(chunkOf(c.chunk_id)!, c.char_start)})`).join(", ")}
    </p>
    <ul class="checks">
      <li><span class="tick mono" aria-hidden="true">✓</span> {t.found}</li>
      <li>
        <span class="tick mono" aria-hidden="true">{supported === claims.length ? "✓" : "✗"}</span>
        <span class="mono">{supported}/{claims.length}</span> {t.claims}
      </li>
      <li><span class="tick mono muted" aria-hidden="true">·</span> {t.confidence} <span class="mono">{decimal(answer.confidence_score, 2, lang)}</span></li>
    </ul>
  </section>

  <section class="card glass refused" role="tabpanel" id="verity-panel-refusal" aria-labelledby="verity-tab-refusal" tabindex="0" data-off>
    <p class="step"><span class="n">1</span> {t.question}</p>
    <p class="q" lang="en" data-verbatim>{refusal.question}</p>
    {lang === "fr" && <p class="tr"><span class="tr-k">traduction</span> {translation(refusal).question.fr}</p>}
    <p class="step"><span class="n">3</span> {t.refused}</p>
    <p class="a" lang="en" data-verbatim><span class="a-text">{refusal.answer_text}</span></p>
    {lang === "fr" && <p class="tr tr-a"><span class="tr-k">traduction</span> {translation(refusal).answer.fr}</p>}
    <p class="verdict">{t.verdict} <span class="mono">{decimal(refusal.confidence_score, 2, lang)}</span></p>
    <p class="ref">{t.closest} {nameOf(slaPath)} ({t.section} {sectionAt(closest, refusalTarget.start)}), {t.insufficient}</p>
    {lang === "fr" ? <p class="tr why"><span class="tr-k">traduction</span> {translation(refusal).rationale!.fr}</p> : <p class="tr why"><span class="tr-k">the model’s words, as recorded; document index 0 is the SLA</span> <span data-verbatim>{translation(refusal).rationale!.en}</span></p>}
  </section>
  </div>

  <p class="source">
    <a class="tip-host" href={answer.source.url} aria-describedby="verity-run-tip">
      {t.source}
      <span class="tip" id="verity-run-tip" role="tooltip">
        {t.run} <span class="mono">{runFile}</span> {t.ofVerity} {answer.example_id} {t.and} {refusal.example_id}{t.contract} <span class="mono">{fileOf(slaPath)}</span>
      </span>
    </a>
  </p>
</div>

<noscript>
  <style is:inline>
    /* Without the script the tabs cannot switch: show both cards and no inert controls. */
    [data-verity-demo] .tabs {
      visibility: hidden;
    }
    [data-verity-demo] .cards {
      display: block;
    }
    #verity-panel-refusal[data-off] {
      visibility: visible;
      opacity: 1;
      transform: none;
      margin-top: 1rem;
    }
    /* Nothing scrolls the window to the passage: the whole contract is shown, the cards below it. */
    [data-verity-demo] [data-sheet] {
      height: auto;
      padding-bottom: 1.25rem;
      mask-image: none;
    }
    [data-verity-demo] .cards {
      margin: 1rem 0 0;
    }
  </style>
</noscript>

<script>
  import { dismissibleTips } from "../scripts/tips.ts";
  import { mountVerityDemo } from "../scripts/verity-demo.ts";
  dismissibleTips();
  for (const root of document.querySelectorAll<HTMLElement>("[data-verity-demo]")) mountVerityDemo(root);
</script>

<style>
  /* The demo is framed as an exhibit: a caption says what it is, the frame where it ends. */
  .demo {
    position: relative;
    padding: 1rem;
    border: 1px solid var(--rule);
    border-radius: 20px;
    /* Depth, barely: the proof green and the night blue of the portrait, 6 % at most, so every
       text on them keeps its contrast (contrast.test.ts). */
    background:
      radial-gradient(60% 50% at 80% 15%, var(--halo-proof), transparent),
      radial-gradient(60% 60% at 15% 90%, var(--halo-night), transparent);
  }

  .caption {
    margin: 0 0 0.75rem;
    font-size: var(--step-14);
    color: var(--graphite);
  }

  /* The three steps of a run, in the order Verity takes them: the question, the passage it
     retrieves (on the contract, by the spotlight), the answer it checks. */
  .step {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.75rem !important;
    font-size: var(--step-12);
    font-weight: 600;
    /* Inter has no small capitals (no smcp feature): capitals at 12 px, tracked, in graphite. */
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--graphite);
  }

  .step:first-child {
    margin-top: 0 !important;
  }

  .n {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--step-12);
    font-weight: 600;
    line-height: 1;
  }

  /* A translation sits indented under the English it translates. */
  .tr {
    margin-top: 0.2rem !important;
    padding-left: 0.75rem;
    font-size: var(--step-12);
    color: var(--graphite);
  }

  .tr-k {
    margin-right: 0.25rem;
    font-weight: 600;
  }

  .tabs {
    margin-bottom: 0.75rem;
  }

  /* On a narrow screen the full labels wrap onto two lines: the tabs say the verb alone, the
     accessible name keeps the whole label. */
  .tabs .short {
    display: none;
  }

  @media (max-width: 30rem) {
    .tabs .long {
      display: none;
    }

    .tabs .short {
      display: inline;
    }
  }

  /* The contract is seen through a window of fixed height, scrolled to the passage in play
     (verity-demo.ts); it fades out at both ends to say that it goes on. It is told apart from
     the frame by its tint alone: one drawn frame, the demo's. */
  .window {
    background: var(--sheet);
    border-radius: 10px;
  }

  .sheet {
    position: relative;
    height: 18rem;
    padding: 1.5rem 1.5rem 1.25rem;
    /* The script scrolls the window to the passage (scrollTo works on hidden overflow); the wheel
       and the finger scroll the page, never the contract. A keyboard reader who focuses the
       window may scroll it with the arrow keys. */
    overflow-y: hidden;
    scrollbar-width: none;
    border-radius: inherit;
    /* Read by verity-demo.ts: where the passage goes, and what the tag above the lens keeps clear of. */
    --target-at: 0.5;
    --fade: 40px;
    --tag-gap: 14px;
    --room: 1.25rem;
    mask-image: linear-gradient(to bottom, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
  }

  /* The mask would also fade a focus outline drawn by the sheet: the window draws it, where
     the browser can select it. */
  @supports selector(:has(*)) {
    .sheet:focus-visible {
      outline: none;
      overflow-y: auto;
    }

    .window:has(.sheet:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }
  }

  .doc {
    font-size: var(--step-14);
    line-height: 1.55;
    color: var(--ink);
  }

  /* The contract's own headings are not the page's: styled paragraphs keep the page outline. */
  .doc .heading {
    margin: 1rem 0 0.25rem;
    font-size: var(--step-14);
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: 0;
  }

  .doc .h1 {
    margin-top: 0;
    font-size: var(--step-16);
  }

  .doc p:not(.heading) {
    margin: 0 0 0.5rem;
  }

  .doc ul {
    margin: 0 0 0.5rem;
    padding-left: 1.1rem;
    /* The serif subset has no bullet (U+2022); the source document marks items with a hyphen. */
    list-style-type: "–\00A0";
  }

  /* Spotlight: once the script runs, the contract steps back and the passage in play keeps the
     ink. --dimmed still meets AA on the sheet (contrast.test.ts): the words around stay legible. */
  .demo[data-lit] .doc {
    color: var(--dimmed);
  }

  .doc [data-o] {
    transition: color var(--dur-move) var(--ease-out);
  }

  /* The lit passage moves its neighbours apart, so the glass ring around it (PAD + --ring) lies
     over blank space, never over another line. The blocks are marked at build time (data-holds),
     so no :has() is needed. The margin is not animated: it must be final when the lens measures
     the words. */

  /* From the static page on, not only once the script lights the passage: added later, the
     margins would shift the contract after the first paint (layout shift). */
  .demo[data-mode="answer"] [data-holds="answer"],
  .demo[data-mode="refusal"] [data-holds="refusal"] {
    /* Above, room for the tag too: it names the passage without hiding the line before it. */
    margin-block: calc(var(--room) + 2.25rem) var(--room);
  }

  /* Highlight follows the mode; the spans were cut at the cited offsets at build time. */
  .demo[data-mode="answer"] [data-mark~="answer"] {
    color: var(--ink);
    background: var(--proof-wash);
    box-shadow: 0 2px 0 var(--proof);
  }

  .demo[data-mode="refusal"] [data-mark~="refusal"] {
    color: var(--ink);
    background: var(--defect-wash);
    box-shadow: 0 2px 0 var(--defect);
  }

  /* The lens box holds the passage; its glass ring is drawn --ring wide outside it. */
  .lens {
    --ring: 7px;
    position: absolute;
    left: 0;
    top: 0;
    box-sizing: content-box;
    margin: calc(-1 * var(--ring));
    padding: var(--ring);
    transform: translate(var(--x, 0), var(--y, 0));
    border-radius: 16px;
    box-shadow: 0 14px 30px -18px rgb(17 17 17 / 0.5);
    transition: opacity var(--dur-hover) var(--ease-out);
    pointer-events: none;
  }

  /* On a change of mode the ring and its tag fade out, move unseen, and fade in on the new
     passage (verity-demo.ts): nothing animates their position or size. */
  .demo[data-away] :is(.lens, .lens-tag) {
    opacity: 0;
  }

  /* Glass only in the ring: the mask cuts out the middle, so the passage stays sharp while the
     ring bends and frosts the dimmed lines around it (.glass, global.css). */
  .ring {
    position: absolute;
    inset: 0;
    padding: var(--ring);
    border: 1px solid var(--glass-edge);
    border-radius: inherit;
    mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
    mask-clip: content-box, border-box;
    mask-composite: exclude;
  }

  /* Above the lens, never over the passage. */
  .lens-tag {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    left: 0;
    top: 0;
    transform: translate(var(--x, 0), var(--y, 0)) translate(-100%, calc(-100% - var(--tag-gap)));
    padding: 0.15rem 0.55rem 0.15rem 0.2rem;
    box-shadow: 0 0 0 1px var(--rule);
    transition: opacity var(--dur-hover) var(--ease-out);
    font-size: var(--step-12);
    white-space: nowrap;
    color: var(--ink);
    background: var(--paper);
    border-radius: 999px;
  }

  .demo[data-mode="answer"] [data-tag-refusal],
  .demo[data-mode="refusal"] [data-tag-answer] {
    display: none;
  }

  /* The tooltip is placed against this line (global .tip), so it is never wider than the demo. */
  .source {
    position: relative;
    margin: 0.75rem 0 0;
    font-size: var(--step-12);
    color: var(--graphite);
  }

  .source a {
    color: inherit;
  }

  /* Over the contract, the card's glass is near-opaque: its text then never sits on the words
     behind it (worst case checked in contrast.test.ts). */
  .card {
    padding: 1.25rem;
    background: var(--card-fill);
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--glass-edge), 0 12px 32px -20px rgb(17 17 17 / 0.4);
  }

  /* Both cards share one grid cell: the cell is as tall as the taller card, so switching modes
     never moves what follows, and the cards cross-fade over each other. The card that is off is
     invisible, so out of the accessibility tree and of the tab order. */
  .cards {
    display: grid;
    margin-top: 1rem;
  }

  /* Each card fills the cell, so the shorter one leaves no blank band under it. */
  .cards > .card {
    grid-area: 1 / 1;
    align-self: stretch;
    transition:
      opacity var(--dur-hover) var(--ease-out),
      transform var(--dur-hover) var(--ease-out),
      visibility var(--dur-hover);
  }

  .cards > .card[data-off] {
    visibility: hidden;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cards > .card[data-off] {
      transform: translateY(4px);
    }

    .card[data-written] .tr-a,
    .card[data-written] .checks li {
      animation: card-in var(--dur-hover) var(--ease-out) backwards;
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .card p {
    margin: 0;
  }

  .q,
  .a {
    font-size: var(--step-16);
  }

  .ref {
    margin-top: 0.6rem !important;
    font-size: var(--step-12);
    color: var(--graphite);
    overflow-wrap: anywhere;
  }

  .checks {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-14);
  }

  /* The answer writes itself (verity-demo.ts) in an aria-hidden layer over the answer, which
     is only made transparent: assistive tech keeps the whole answer and the checks throughout. */
  .a {
    position: relative;
  }

  .a :global(.a-layer) {
    position: absolute;
    inset: 0;
  }

  .a :global(.unwritten) {
    visibility: hidden;
  }

  .card[data-writing] .a-text,
  .card[data-writing] .tr-a,
  .card[data-writing] .checks li {
    opacity: 0;
  }

  .checks li:nth-child(2) {
    animation-delay: 120ms;
  }

  .checks li:nth-child(3) {
    animation-delay: 240ms;
  }

  .tick {
    display: inline-block;
    width: 1.1em;
    color: var(--proof-text);
  }

  .tick.muted {
    color: var(--graphite);
  }

  /* A refusal where the evidence is missing is the expected outcome: proof colour, not defect. */
  .verdict {
    margin-top: 0.75rem !important;
    color: var(--proof-text);
    font-weight: 600;
  }

  .why {
    margin-top: 0.5rem !important;
  }

  /* Wide screens: the answer card overlaps the bottom right of the window, so the question,
     its passage in the spotlight and the answer fit on the first screen together. */
  @media (min-width: 64rem) {
    /* The card covers the lower half of the window: the passage is centred in the upper part,
       and the padding lets the end of the contract scroll up there too. */
    /* Below 80rem the passage wraps on more lines: a taller window keeps it above the card. */
    .demo {
      --window-height: 25rem;
      --card-overlap: 11.5rem;
    }

    @media (min-width: 80rem) {
      .demo {
        --window-height: 22.5rem;
      }
    }

    /* The contract fades out just above the card's top: the strip of it left of the card would
       show only cut words (a heading cut in half, in refusal mode). */
    .sheet {
      height: var(--window-height);
      padding-bottom: 12rem;
