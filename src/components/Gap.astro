---
/** A piece of content no source provides: shown as a visible gap, never filled in (SPEC §6). */
interface Props {
  lang?: "fr" | "en";
}
const { lang = "fr" } = Astro.props;
---

<span class="gap">{lang === "fr" ? "Manquant :" : "Missing:"} <slot /></span>

<style>
  .gap {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    font-size: var(--step-14);
    color: var(--defect);
    border: 1px dashed var(--defect);
    border-radius: 4px;
  }
</style>
