---
import CaseStudy from "../../layouts/CaseStudy.astro";
import Brief from "../../components/case/Brief.astro";
import CaseSection from "../../components/case/CaseSection.astro";
import Diagram from "../../components/case/Diagram.astro";
import MeasuresDetail from "../../components/case/MeasuresDetail.astro";
import MeasuresTable from "../../components/case/MeasuresTable.astro";
import Limit from "../../components/case/Limit.astro";
import Figure from "../../components/Figure.astro";
import { measure } from "../../lib/measures.ts";
import { pinned } from "../../lib/sources.ts";
import answer from "../../data/demo/answer.json";

const at = (path: string) => pinned("verity", path);
// The run of record of the release the figures come from; the demo replays an earlier test run.
// Hashes stay in the links, out of the prose.
const runOfRecord = at("datasets/eval/runs/live/eval_513b839_test.incomplete-20261107T122042441670Z.json");
const demoRun = answer.source.url;

// Both quotes come from data that npm run check:sources compares with GitHub: the cited
// passage from the committed run (demo/answer.json), the threshold sentence from the
// evidence of its measure.
const DEFECT = "twentyfour";
const cited = answer.citations.find((c) => c.quote.includes(DEFECT));
if (!cited) throw new Error(`no citation of the demo answer contains "${DEFECT}"`);
const [before, after] = cited.quote.split(DEFECT) as [string, string];
const thresholdSentence = measure("verity.threshold_run_of_record").evidence.find((e) => "contains" in e && e.contains.startsWith("The threshold decides"));
if (!thresholdSentence || !("contains" in thresholdSentence)) throw new Error("the threshold sentence is not in the measure's evidence");
// The French line under each English quote, keyed by the exact English it translates: a quote
// that changes at its source no longer finds its translation, and the build fails.
const TRANSLATED: Record<string, string> = {
  "The threshold decides nothing on this data, and refuses nothing by default.": "Le seuil ne décide rien sur ces données, et ne refuse rien par défaut.",
  "Premium Support shortens the Priority 1 response time to thirty (30) minutes, twentyfour hours a day, seven days a week.":
    "Le Premium Support ramène le délai de réponse en priorité 1 à trente (30) minutes, vingt-quatre heures sur vingt-quatre, sept jours sur sept.",
};
const translated = (en: string) => {
  const fr = TRANSLATED[en];
  if (!fr) throw new Error(`no French translation for the quote "${en}"`);
  return fr;
};
---

<CaseStudy
  no="01"
  name="Verity"
  repo="verity"
  serif
  summary="Un agent qui répond aux questions sur des contrats en citant la clause mot pour mot, et qui refuse quand il n’a pas de preuve."
  description="Étude de cas de Verity, agent qui répond sur des contrats en citant ses sources : problème, architecture, mesures avec leurs incertitudes, défauts, décisions."
>
  <Brief
    slot="brief"
    does="Il répond aux questions sur un ensemble de contrats en citant la clause exacte, et dit « je ne sais pas » quand les documents ne contiennent pas la réponse."
    measured="Sur des questions de test jamais vues pendant le réglage : s’il refuse les questions sans réponse et si ses réponses inventent quelque chose. Sur les questions de réglage et de test : s’il fait mieux que la même chaîne sans contrôles."
    defect="Il répond encore à des questions qui n’ont pas de réponse dans les documents ; les questions en cause sont nommées dans les résultats publiés."
    figures={[
      { id: "verity.invented_answer_rate", caption: "réponses contenant une invention, sur toutes les réponses données, que la question ait une réponse ou non (selon le juge)" },
      { id: "verity.refusal_recall", caption: "questions sans réponse correctement refusées" },
      { id: "verity.unanswerable_answered", caption: "questions sans réponse auxquelles il a quand même répondu", defect: true },
    ]}
  />

  <CaseSection n={1} id="probleme" title="Le problème" lead="En trois phrases, pourquoi ce projet existe.">
    <p>
      Les assistants qui répondent sur des documents d’entreprise le font avec assurance, et se trompent juste assez souvent pour être dangereux. Sur un contrat, une réponse fluide mais fausse coûte plus
      cher qu’un « je ne sais pas ». Verity ne répond qu’en citant la clause mot pour mot, refuse sinon, et mesure s’il refuse à raison.
    </p>
  </CaseSection>

  <CaseSection
    n={2}
    id="construit"
    title="Ce que j’ai construit"
    lead="Le chemin d’une question, de la recherche des passages à la réponse ou au refus : on y voit où se décide un refus."
  >
    <Diagram
      id="verity-pipeline"
      title="Le chemin d’une question dans Verity"
      steps={[
        { title: "Question", lines: ["sur un corpus de contrats et de politiques"] },
        { title: "Recherche des passages", lines: ["par le sens et par les mots,", "puis tri des passages les plus utiles"] },
        { title: "Rédaction avec citations", lines: ["chaque citation doit être un extrait exact", "du document ; sans citation, refus"] },
        { title: "Contrôles en code, sans modèle", lines: ["citations : couvrent-elles la réponse ?", "manipulation ?", "un seul échec refuse"] },
        { title: "Note de confiance et seuil", lines: ["un modèle note la réponse et peut refuser ;", "il ne peut pas annuler un contrôle"] },
      ]}
      outcomes={[
        { title: "Réponse citée", lines: ["clause et position"], tone: "proof" },
        { title: "Refus motivé", lines: ["cause enregistrée"], tone: "defect" },
      ]}
      desc="Une question porte sur un corpus de contrats et de politiques. Verity cherche les passages par le sens et par les mots, puis trie les plus utiles. Il rédige une réponse où chaque citation doit être un extrait exact du document ; sans citation, il refuse. Des contrôles écrits en code, sans modèle, vérifient que les citations couvrent la réponse et que rien ne les manipule ; un seul échec suffit à refuser. Enfin un modèle note la réponse et peut refuser sous un seuil, sans pouvoir annuler un contrôle. Deux issues : une réponse qui cite sa clause et sa position, ou un refus dont la cause est enregistrée."
      caption="Le refus se décide dans l’ordre : pas de citation, puis les contrôles écrits en code, puis la note de confiance et son seuil. Le juge, un second modèle qui note les réponses, n’est pas sur ce chemin : il évalue les exécutions après coup."
    />
    <p>
      Verity est un agent RAG : il cherche d’abord les passages utiles dans les documents, puis rédige sa réponse à partir d’eux. Il garde la position exacte de chaque passage dans son document et renvoie soit
      une réponse dont chaque citation se retrouve telle quelle dans la source, soit un refus avec sa cause. La démonstration de l’<a href="/">accueil</a> rejoue des réponses d’une exécution réelle.
    </p>
  </CaseSection>

  <CaseSection
    n={3}
    id="mesures"
    title="Mesures"
    lead="Ce que valent ses réponses et ses refus, chiffres à l’appui, avec leur incertitude et une comparaison à un système plus simple."
  >
    <p>
      Les chiffres viennent de l’<a href={runOfRecord}>exécution de référence</a> de la version publiée, sur des questions de test jamais vues pendant le réglage ; le plafond de dépense l’a arrêtée
      avant les deux dernières questions, qui ne comptent nulle part. Sur les questions dont les documents ne contiennent pas la réponse, Verity en refuse <Figure id="verity.refusal_recall" where="prose" />,
      mais répond quand même à <Figure id="verity.unanswerable_answered" where="prose" defect />. Le juge, un second modèle chargé de noter les réponses, trouve une invention dans <Figure
        id="verity.invented_answer_rate"
        where="prose"
      /> réponses données (<code>q-089</code>), toutes questions comptées. L’ancienne définition ne comptait que les questions qui ont une réponse : elle excluait par construction la seule invention réelle de
      l’exécution précédente (<code>q-074</code>). Elle donne ici <Figure id="verity.hallucination_rate" where="prose" /> et reste publiée dans le détail, avec sa définition.
    </p>
    <p>
      Ce juge s’accorde avec mes propres notes, posées sans voir les siennes, à <Figure id="verity.judge_kappa_v020" where="prose" />, sur une partie seulement des affirmations de validation : son budget a
      arrêté la vérification avant la fin. C’est un kappa de Cohen, une mesure d’accord qui retire la part due au hasard, de zéro pour le hasard à un pour un accord parfait. L’ancienne consigne du juge, celle
      des exécutions précédentes, atteignait <Figure id="verity.judge_kappa_all" where="prose" /> sur des affirmations où une seule hallucination est réelle ; son intervalle figure dans le détail.
    </p>
    <p>
      Face à un RAG naïf, la même recherche et la même rédaction sans aucun contrôle, la comparaison a été pré-enregistrée et porte sur les questions de réglage et de test terminées par les deux. Verity
      traite comme si elles avaient une réponse <Figure id="verity.twoarm_unanswerable_answered_verity" where="prose" /> questions sans réponse, contre <Figure
        id="verity.twoarm_unanswerable_answered_naive"
        where="prose"
      /> pour le RAG naïf : l’écart est net (test apparié, corrigé pour trois comparaisons : p = <Figure id="verity.twoarm_unanswerable_answered_p" where="prose" />). Il répond à <Figure
        id="verity.twoarm_answerable_answered_verity"
        where="prose"
      /> questions qui ont une réponse, contre <Figure id="verity.twoarm_answerable_answered_naive" where="prose" />, et donne <Figure id="verity.twoarm_invented_answer_verity" where="prose" /> réponse inventée
      (<code>q-089</code>, qui se récuse tout en affirmant quelque chose, compte ici comme un refus selon la règle pré-enregistrée, alors que l’encadré « En bref » la compte comme une invention),
      contre <Figure id="verity.twoarm_invented_answer_naive" where="prose" /> : à cette taille, ni ce coût ni ce gain ne se distinguent du hasard (p = <Figure
        id="verity.twoarm_answerable_answered_p"
        where="prose"
      /> et <Figure id="verity.twoarm_invented_answer_p" where="prose" />). Le gain mesuré est le refus ; le reste n’est pas mesurable sur ces données.
    </p>
    <MeasuresDetail>
      <p>
        Seuil de refus de l’exécution, qui est aussi celui du code : <Figure
          id="verity.threshold_run_of_record"
          where="detail"
        />.
      </p>
      <MeasuresTable
        where="run"
        caption="Exécution de référence, questions de test"
        rows={[
          { id: "verity.invented_answer_rate", reading: "Toutes les réponses données, que la question ait une réponse ou non. Une seule invention, nommée dans les résultats." },
          { id: "verity.refusal_recall", reading: "Questions sans réponse dans les documents, refusées." },
          { id: "verity.refusal_precision", reading: "Refus qui portaient sur une question vraiment sans réponse ; l’autre vient d’un contrôle de citation." },
          { id: "verity.unanswerable_answered", defect: true, reading: "Le défaut principal : une réponse livrée là où les documents n’en contiennent pas." },
          { id: "verity.hallucination_rate", reading: "L’ancienne définition : une réponse à une question sans réponse en est exclue. Zéro observé n’est pas zéro garanti : d’où l’intervalle." },
          {
            id: "verity.judge_kappa_v020",
            noInterval: "Kappa n’est pas une proportion, et le fichier source ne donne pas d’intervalle pour cette vérification incomplète.",
            reading: "Le juge de cette exécution, face à mes notes posées à l’aveugle ; son budget l’a arrêté avant la fin.",
          },
          {
            id: "verity.judge_kappa_all",
            noInterval: "Kappa n’est pas une proportion : son intervalle bootstrap est dans l’intitulé.",
            reading: "Le juge des exécutions précédentes, affirmations réelles et piégées.",
          },
          {
            id: "verity.judge_kappa_real",
            noInterval: "Kappa n’est pas une proportion : le fichier source ne lui donne pas d’intervalle utile.",
            reading: "Fragile : presque aucune affirmation réelle n’est jugée non étayée par l’humain, si bien qu’un désaccord le déplace fortement.",
          },
          { id: "verity.judge_traps_detected", reading: "Borne haute : une affirmation piégée compte comme détectée dès qu’une de ses parties est rejetée." },
        ]}
      />
      <MeasuresTable
        where="naive"
        caption="Contre un RAG naïf, comparaison pré-enregistrée (questions de réglage et de test)"
        ours="Verity"
        baseline="RAG naïf"
        rows={[
          {
            id: "verity.twoarm_unanswerable_answered_verity",
            base: "verity.twoarm_unanswerable_answered_naive",
            label: "Questions sans réponse traitées comme si elles en avaient une",
            reading: "Les contrôles de Verity refusent des questions sans réponse auxquelles la version naïve répond : écart significatif après correction.",
          },
          {
            id: "verity.twoarm_answerable_answered_verity",
            base: "verity.twoarm_answerable_answered_naive",
            label: "Questions avec réponse traitées",
            reading: "Aucun coût mesurable à cette taille d’échantillon.",
          },
          {
            id: "verity.twoarm_invented_answer_verity",
            base: "verity.twoarm_invented_answer_naive",
            label: "Réponses inventées",
            reading: "Aucune différence mesurable à cette taille d’échantillon.",
          },
        ]}
      />
      <p>
        Une réponse qui se récuse d’elle-même compte comme un refus, dans les deux bras : la version naïve ne refuse jamais, et la comparaison serait sinon gagnée d’avance. Le plafond de dépense a arrêté
        l’exécution de test de Verity avant la fin ; la comparaison porte sur les questions terminées par les deux (<a href={at("scorecards/two-arm-comparison.json")}>fichier de comparaison</a>, <a
          href={at("docs/preregistration/two-arm-comparison.md")}>pré-enregistrement</a
        >).
      </p>
    </MeasuresDetail>
  </CaseSection>

  <CaseSection n={4} id="echecs" title="Limites connues et prochaines étapes" lead="Deux limites que les chiffres seuls ne montrent pas, chacune avec son périmètre et sa prochaine étape.">
    <Limit title="Le seuil de confiance ne décide rien">
      <Fragment slot="scope">La note de confiance qu’un modèle donne à chaque réponse, et le seuil sous lequel Verity peut refuser.</Fragment>
      <Fragment slot="limit">
        Le seuil livré, celui de l’exécution de référence, est <Figure id="verity.threshold_run_of_record" where="threshold" /> : la règle fixée à l’avance l’a choisi sur les questions de réglage, où aucun
        seuil ne faisait mieux qu’un autre, et à cette valeur il ne refuse rien. Chaque refus vient d’un contrôle écrit en code ou du modèle de notation ; la note de confiance est l’auto-évaluation du modèle,
        et elle ne correspond pas à sa fréquence réelle d’erreur.
        <blockquote lang="en">
          <p data-verbatim>{thresholdSentence.contains}</p>
          <p class="tr" lang="fr"><span class="tr-k">traduction</span> {translated(thresholdSentence.contains)}</p>
          <footer lang="fr"><a href={at("docs/results.md")}>docs/results.md</a></footer>
        </blockquote>
      </Fragment>
      <Fragment slot="next">Un refus fondé sur une confiance fiable, inscrit dans la <a href={at("docs/features.md#roadmap")}>feuille de route</a> et non revendiqué tant que la mesure ne le soutient pas.</Fragment>
    </Limit>

    <Limit title="Une citation exacte d’un texte mal extrait">
      <Fragment slot="scope">Le contrôle « mot pour mot », qui vérifie que chaque citation se trouve dans le texte extrait du document.</Fragment>
      <Fragment slot="limit">
        <blockquote lang="en">
          <p data-verbatim>
            {before}{DEFECT} <span class="sic" lang="en">[sic, PDF extraction defect]</span>{after}
          </p>
          <p class="tr" lang="fr"><span class="tr-k">traduction</span> {translated(cited.quote)}</p>
          <footer lang="fr">Citation de la réponse à <code>{answer.example_id}</code>, <a href={demoRun}>exécution de test précédente</a></footer>
        </blockquote>
        Dans le <a href={at("datasets/corpus/order_form_northwind_2025.pdf")}>PDF du bon de commande</a>, « twenty- » finit une ligne et « four » commence la suivante ; l’extraction du texte a recollé les deux
        sans le trait d’union. Le contrôle a accepté la citation, qui recopie fidèlement le passage fautif : il prouve qu’une citation est dans le texte extrait, pas que ce texte est fidèle au document.
      </Fragment>
      <Fragment slot="next">
        Non planifiée. Une règle proposée par un audit, refuser toute réponse dont un chiffre manque à ses citations, a été mesurée sur les exécutions publiées avant d’être activée : elle refusait des réponses
        justes (chiffres calculés, repris de la question, identifiants, et ici une durée écrite en chiffres puis en lettres). Elle reste désactivée (<a
          href={at("docs/audit/2026-11-03-figure-rule-measurement.md")}>mesure</a
        >).
      </Fragment>
    </Limit>
  </CaseSection>

  <CaseSection
    n={5}
    id="decisions"
    title="Trois décisions"
    lead="Trois choix d’architecture, chacun écrit dans une note de décision (ADR) avec ses raisons et ses conséquences : de quoi juger le raisonnement, pas seulement le résultat."
  >
    <ol class="decisions">
      <li>
        <h3>Le refus est une réponse à part entière, et il est mesuré</h3>
        <p>
          Le jeu d’évaluation contient volontairement des questions sans réponse, et la justesse des refus fait partie des mesures principales. Une contribution qui fait répondre plus souvent en répondant à
          tort est une régression. La note promettait un refus « calibré », c’est-à-dire une confiance qui correspond à la fréquence réelle d’erreur ; la mesure l’a contredite, et la note le dit en tête.
        </p>
        <p><a href={at("docs/adr/0003-refusal-as-headline-feature.md")}>ADR 0003</a></p>
      </li>
      <li>
        <h3>On reproduit le fichier d’exécution, pas la sortie du modèle</h3>
        <p>
          Aucun appel ne règle l’aléa du modèle. Une exécution réelle est enregistrée une fois, avec la version du code, les modèles et le détail de chaque question, et n’est jamais réécrite ; tous les chiffres
          publiés sont recalculés depuis ce fichier. Deux exécutions de la même version peuvent différer : c’est l’aléa du modèle, rapporté comme tel.
        </p>
        <p><a href={at("docs/adr/0007-reproducibility-from-artefacts.md")}>ADR 0007</a></p>
      </li>
      <li>
        <h3>Des fichiers de consignes lus localement, sans PromptLang</h3>
        <p>
          Une note antérieure prévoyait de compiler les consignes du modèle avec PromptLang, mon autre projet ; cette intégration n’a jamais été construite. Plutôt que de garder la promesse, j’ai inscrit l’état
          réel : un petit lecteur de fichiers testé, une erreur si une variable manque, les contenus non fiables balisés comme données. La dépendance aurait servi un récit, pas un besoin.
        </p>
        <p><a href={at("docs/adr/0005-prompt-files-without-promptlang.md")}>ADR 0005</a></p>
      </li>
    </ol>
  </CaseSection>

  <CaseSection n={6} id="construction" title="Comment c’est construit" lead="Pour un lecteur technique : la pile, les outils et les modèles de l’exécution de référence.">
    <p>
      Python, FastAPI, Postgres avec pgvector (ou un stockage en mémoire), modèles locaux pour comparer le sens des textes et trier les passages, clients Anthropic et OpenAI derrière un routeur de repli,
      interface Next.js. Outillage : uv, ruff, mypy strict, pytest, GitHub Actions.
    </p>
    <p>
      Exécution de référence : agent <code>{answer.run.agent_model}</code>, juge <code>{answer.run.judge_model}</code>, comparaison du sens <code>{answer.run.embedding_model}</code>. Architecture détaillée : <a
        href={at("docs/architecture.md")}>docs/architecture.md</a
      >.
    </p>
  </CaseSection>

  <CaseSection n={7} id="suite" title="La suite" lead="Ce qui manque encore, d’après le projet lui-même.">
    <ul>
      <li>La comparaison au corpus entier placé dans la consigne du modèle : spécifiée dans le pré-enregistrement, non exécutée.</li>
      <li>Un refus fondé sur une confiance fiable : l’erreur de confiance mesurée sur le test ne le permet pas.</li>
      <li>Un juge d’une autre famille de modèles, et un second annotateur humain.</li>
      <li>La lecture de pages web : le code existe, aucun test ne le couvre.</li>
    </ul>
    <p><a href={at("docs/features.md#roadmap")}>Feuille de route</a> · <a href={at("docs/results.md")}>ce que les chiffres ne disent pas</a></p>
  </CaseSection>
</CaseStudy>
