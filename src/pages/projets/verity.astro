---
import CaseStudy from "../../layouts/CaseStudy.astro";
import CaseSection from "../../components/case/CaseSection.astro";
import Diagram from "../../components/case/Diagram.astro";
import MeasuresTable from "../../components/case/MeasuresTable.astro";
import Figure from "../../components/Figure.astro";
import { measure } from "../../lib/measures.ts";
import { pinned } from "../../lib/sources.ts";
import answer from "../../data/demo/answer.json";

const at = (path: string) => pinned("verity", path);

// Both quotes come from data that npm run check:sources compares with GitHub: the cited
// passage from the committed run (demo/answer.json), the threshold sentence from the
// evidence of its measure.
const DEFECT = "twentyfour";
const cited = answer.citations.find((c) => c.quote.includes(DEFECT));
if (!cited) throw new Error(`no citation of the demo answer contains "${DEFECT}"`);
const [before, after] = cited.quote.split(DEFECT) as [string, string];
const thresholdSentence = measure("verity.threshold_run_of_record").evidence.find((e) => "contains" in e && e.contains.startsWith("The threshold decides"));
if (!thresholdSentence || !("contains" in thresholdSentence)) throw new Error("the threshold sentence is not in the measure's evidence");
---

<CaseStudy
  no="01"
  name="Verity"
  repo="verity"
  serif
  summary="Un agent RAG sur des documents d’entreprise : il répond en citant mot pour mot, refuse quand ses preuves sont faibles, et publie à quelle fréquence il refuse à raison."
  description="Étude de cas de Verity, agent RAG à citations vérifiées : problème, architecture, mesures avec intervalles et baseline, défauts, décisions."
>
  <CaseSection n={1} id="probleme" title="Le problème">
    <p>
      Un RAG d’entreprise répond avec assurance, et se trompe juste assez souvent pour être dangereux. Sur un contrat, une réponse fluide sans preuve coûte plus cher qu’un « je ne sais pas ». Verity ne
      répond qu’en citant la clause mot pour mot, refuse sinon, et mesure s’il refuse à raison.
    </p>
  </CaseSection>

  <CaseSection n={2} id="construit" title="Ce que j’ai construit">
    <Diagram
      id="verity-pipeline"
      title="Le chemin d’une question dans Verity"
      steps={[
        { title: "Question", lines: ["sur un corpus de contrats et de politiques"] },
        { title: "Recherche hybride", lines: ["dense et lexicale, fusion des rangs,", "reranker cross-encoder local"] },
        { title: "Synthèse avec citations", lines: ["chaque citation doit être un extrait exact", "du document ; sans citation, refus"] },
        { title: "Contrôles déterministes", lines: ["couverture des citations, pertinence,", "marqueurs d’injection : un échec refuse"] },
        { title: "Score de confiance et seuil", lines: ["le modèle de score peut refuser ; il ne", "peut pas annuler un contrôle précédent"] },
      ]}
      outcomes={[
        { title: "Réponse citée", lines: ["clause et position"], tone: "proof" },
        { title: "Refus motivé", lines: ["cause enregistrée"], tone: "defect" },
      ]}
      caption="Le refus est décidé dans l’ordre : pas de citation, puis les contrôles déterministes, puis le modèle de score et son seuil. Le juge LLM n’est pas sur ce chemin : il note les runs d’évaluation après coup."
    />
    <p>
      Verity indexe des contrats, des politiques et des formulaires de commande, garde la position de chaque passage dans son document, et renvoie soit une réponse dont chaque citation est retrouvée
      telle quelle dans la source, soit un refus avec sa cause. La démonstration de l’<a href="/">accueil</a> rejoue des réponses d’un run réel.
    </p>
  </CaseSection>

  <CaseSection n={3} id="mesures" title="Mesures">
    <p>
      Run de référence <code>969e1d5</code> sur le split de test, seuil <Figure id="verity.threshold_run_of_record" where="intro" />. Chaque chiffre mène à l’artefact qui le contient, au commit épinglé.
    </p>
    <MeasuresTable
      where="run"
      caption="Run de référence, split de test"
      rows={[
        { id: "verity.refusal_recall", reading: "Questions sans réponse dans le corpus, refusées." },
        { id: "verity.refusal_precision", reading: "Refus qui portaient sur une question vraiment sans réponse ; les autres viennent des contrôles de citation." },
        { id: "verity.unanswerable_answered", defect: true, reading: "Le défaut principal : une réponse livrée là où le corpus n’en contient pas." },
        { id: "verity.hallucination_rate", reading: "Selon le juge LLM validé ci-dessous. Zéro observé n’est pas zéro garanti : d’où l’intervalle." },
        {
          id: "verity.judge_kappa_all",
          noInterval: "Kappa n’est pas une proportion : l’artefact ne lui donne pas d’intervalle.",
          reading: "Accord du juge avec mes étiquettes posées à l’aveugle, affirmations réelles et piégées.",
        },
        {
          id: "verity.judge_kappa_real",
          noInterval: "Kappa n’est pas une proportion : l’artefact ne lui donne pas d’intervalle.",
          reading: "Fragile : presque aucune affirmation réelle n’est dans la classe minoritaire humaine, si bien qu’un désaccord le déplace fortement.",
        },
        { id: "verity.judge_traps_detected", reading: "Borne haute : une affirmation piégée compte comme détectée dès qu’une de ses sous-affirmations est rejetée." },
      ]}
    />
    <MeasuresTable
      where="naive"
      caption="Contre un RAG naïf (split de dev, runs incomplets)"
      ours="Verity"
      baseline="RAG naïf"
      rows={[
        {
          id: "verity.baseline_verity_answerable_answered",
          base: "verity.baseline_naive_answerable_answered",
          label: "Questions avec réponse traitées",
          reading: "Non distinguables selon l’artefact. Verity refuse davantage, sans gain mesuré en échange.",
        },
        {
          id: "verity.baseline_verity_hallucination_rate",
          base: "verity.baseline_naive_hallucination_rate",
          label: "Taux d’hallucination (juge)",
          reading: "Aucune hallucination mesurée d’un côté comme de l’autre : rien à départager.",
        },
        {
          id: "verity.baseline_verity_unanswerable_answered",
          base: "verity.baseline_naive_unanswerable_answered",
          label: "Questions sans réponse auxquelles il a répondu",
          reading: "L’avantage attendu de Verity, mais sur si peu de questions que l’artefact ne le distingue pas.",
        },
      ]}
    />
    <p>
      Sur ces données, aucune différence avec un RAG naïf n’est distinguable, sur aucune ligne. Le budget a arrêté les deux runs avant la fin ; la comparaison porte sur les questions que les deux bras ont terminées (<a
        href={at("scorecards/naive-baseline-comparison.json")}>comparaison</a
      >). C’est le résultat publié, pas le résultat favorable.
    </p>
  </CaseSection>

  <CaseSection n={4} id="echecs" title="Ce qui n’a pas marché, et ce que j’ai fait">
    <h3>Le seuil de confiance ne décide rien</h3>
    <p>
      Le code refuse par défaut sous un score de <Figure id="verity.threshold_code_default" where="threshold" />. Le run de référence a tourné à <Figure
        id="verity.threshold_run_of_record"
        where="threshold"
      />
      : le seuil a été choisi sur le split de dev par une règle fixée avant le run, et aucun seuil ne faisait mieux qu’un autre.
    </p>
    <blockquote lang="en">
      <p>{thresholdSentence.contains}</p>
      <footer><a href={at("docs/results.md")}>docs/results.md</a></footer>
    </blockquote>
    <p>
      Chaque refus du run vient d’une cause déterministe ou du modèle de score lui-même ; aucun n’est « sous le seuil ». Le score est l’auto-évaluation du modèle et il n’est pas calibré. Ce que j’ai fait : le publier. Le seuil réel figure à
      côté du défaut du code, et le refus calibré est dans la feuille de route au lieu d’être revendiqué.
    </p>

    <h3>Une citation exacte d’un texte mal extrait</h3>
    <blockquote lang="en">
      <p>
        {before}{DEFECT} <span class="sic" lang="en">[sic, PDF extraction defect]</span>{after}
      </p>
      <footer>Citation de la réponse à <code>{answer.example_id}</code>, run de référence (<a href={answer.source.url}>artefact</a>)</footer>
    </blockquote>
    <p>
      Dans le <a href={at("datasets/corpus/order_form_northwind_2025.pdf")}>PDF du bon de commande</a>, « twenty- » finit une ligne et « four » commence la suivante ; l’extraction a recollé les deux sans le
      trait d’union. Le contrôle « mot pour mot » l’a accepté, puisque la citation recopie fidèlement le passage fautif : il prouve que la citation est dans le corpus extrait, pas que le corpus extrait est
      fidèle au document.
    </p>
    <p>
      Un audit a proposé une règle : refuser toute réponse dont un chiffre n’est pas dans ses citations. Mesurée sur les runs publiés avant de l’activer, elle refusait des réponses justes, pour des
      chiffres calculés, des chiffres repris de la question, des identifiants, et ici une durée écrite en chiffres dans la réponse et en lettres dans la citation fautive. Elle n’est pas activée (<a
        href={at("docs/audit/2026-11-03-figure-rule-measurement.md")}>mesure</a
      >).
    </p>
  </CaseSection>

  <CaseSection n={5} id="decisions" title="Trois décisions">
    <ol class="decisions">
      <li>
        <h3>Le refus est une sortie de premier rang, mesurée</h3>
        <p>
          Le jeu d’évaluation contient volontairement des questions sans réponse, et la précision et le rappel du refus sont des métriques de tête. Une contribution qui fait répondre plus souvent en répondant
          à tort est une régression. L’ADR promettait un refus « calibré » ; la mesure l’a contredite, et l’ADR le dit en tête.
        </p>
        <p><a href={at("docs/adr/0003-refusal-as-headline-feature.md")}>ADR 0003</a></p>
      </li>
      <li>
        <h3>On reproduit l’artefact, pas la sortie du modèle</h3>
        <p>
          Aucun appel n’envoie de paramètre d’échantillonnage. Un run live est enregistré une fois, avec le commit, les modèles et l’audit de chaque question, et n’est jamais réécrit ; tous les chiffres
          publiés sont recalculés depuis ce fichier. Deux runs sur le même commit peuvent différer : c’est la variance du modèle, rapportée comme telle.
        </p>
        <p><a href={at("docs/adr/0007-reproducibility-from-artefacts.md")}>ADR 0007</a></p>
      </li>
      <li>
        <h3>Des fichiers de prompt lus localement, sans PromptLang</h3>
        <p>
          Une ADR antérieure prévoyait de compiler les prompts avec PromptLang, mon autre projet ; l’intégration n’a jamais été construite. Plutôt que de garder la promesse, j’ai inscrit l’état réel : un petit
          parseur testé, une erreur si une variable manque, les entrées non fiables entre délimiteurs. La dépendance aurait servi un récit, pas un besoin.
        </p>
        <p><a href={at("docs/adr/0005-prompt-files-without-promptlang.md")}>ADR 0005</a></p>
      </li>
    </ol>
  </CaseSection>

  <CaseSection n={6} id="construction" title="Comment c’est construit">
    <p>
      Python, FastAPI, Postgres avec pgvector (ou un store en mémoire), embeddings et reranker locaux, clients Anthropic et OpenAI derrière un routeur de repli, interface Next.js. Outillage : uv, ruff, mypy
      strict, pytest, GitHub Actions.
    </p>
    <p>
      Run de référence : agent <code>{answer.run.agent_model}</code>, juge <code>{answer.run.judge_model}</code>, embeddings <code>{answer.run.embedding_model}</code>. Architecture détaillée : <a
        href={at("docs/architecture.md")}>docs/architecture.md</a
      >.
    </p>
  </CaseSection>

  <CaseSection n={7} id="suite" title="La suite">
    <ul>
      <li>Un run publié du pipeline actuel : les runs de référence précèdent les prompts actuels (synthèse avec données balisées, juge à entrées délimitées).</li>
      <li>Un refus calibré : l’erreur de calibration mesurée sur le test ne le permet pas.</li>
      <li>Un juge d’une autre famille de modèles, et un second annotateur humain.</li>
      <li>L’ingestion de pages web : le parseur existe, aucun test ne l’exerce.</li>
    </ul>
    <p><a href={at("README.md#roadmap")}>Feuille de route</a> · <a href={at("docs/results.md")}>ce que les chiffres ne disent pas</a></p>
  </CaseSection>
</CaseStudy>
