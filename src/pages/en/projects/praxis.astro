---
import CaseStudy from "../../../layouts/CaseStudy.astro";
import Brief from "../../../components/case/Brief.astro";
import CaseSection from "../../../components/case/CaseSection.astro";
import Diagram from "../../../components/case/Diagram.astro";
import MeasuresDetail from "../../../components/case/MeasuresDetail.astro";
import MeasuresTable from "../../../components/case/MeasuresTable.astro";
import Figure from "../../../components/Figure.astro";
import { pinned, pull } from "../../../lib/sources.ts";

const at = (path: string) => pinned("praxis", path);
---

<CaseStudy
  no="03"
  name="Praxis"
  repo="praxis"
  summary="A tool that turns a business question into an analysis note (a briefing) written by AI models, whose sources are checked by code and whose drafting is reviewed by a model tasked with finding the flaw."
  description="Case study of Praxis, AI-written analysis briefings with checked sources: problem, architecture, measures, defects, decisions."
>
  <Brief
    does="From a business question, it searches the web, checks in code that every fact has an acceptable source, then writes an analysis note that itself says what it could not source."
    measured="How many real, paid runs end in a note, what a note costs, and how many notes pass the source check."
    defect="No real note passes the source check. What I did about it: the note is delivered anyway, with a section written by the code that lists every unsourced item; the defect is published, not hidden."
    figures={[
      { id: "praxis.live_completed", caption: "real runs that reached the end, out of the attempts" },
      { id: "praxis.cost_per_briefing", caption: "cost of a completed note, from the cheapest to the most expensive" },
      { id: "praxis.insufficiently_sourced", caption: "completed notes flagged as insufficiently sourced", defect: true },
    ]}
  />

  <CaseSection n={1} id="probleme" title="The problem" lead="In two sentences, why this project exists.">
    <p>
      An analysis note written by an AI model looks sourced even when it is not. Praxis writes a note in a chosen format (preparation note, memo, position paper) and tells the reader, in the text
      itself, what rests on a verifiable source and what does not.
    </p>
  </CaseSection>

  <CaseSection n={2} id="construit" title="What I built" lead="The stages of a note, from the question to the delivered file, and the two possible outcomes.">
    <Diagram
      id="praxis-pipeline"
      title="The stages of a Praxis note"
      steps={[
        { title: "Scoping", lines: ["what the question covers, which format"] },
        { title: "Web search", lines: ["facts, actors, risks, options:", "every item carries its source"] },
        { title: "Source check, in code", lines: ["missing source, unreliable site,", "page too old, duplicate"] },
        { title: "Drafting", lines: ["one model call per section"] },
        { title: "Adversarial review", lines: ["a model looks for the flaw; it may", "restart the drafting, once at most"] },
        { title: "Delivered file", lines: ["Markdown, PDF, Word"] },
      ]}
      outcomes={[
        { title: "Sourced", lines: ["delivered;", "every item", "has a source"], tone: "proof" },
        { title: "Flagged", lines: ["delivered;", "a section lists", "every item", "without a source"], tone: "defect" },
      ]}
      caption="Every stage calls an Anthropic model, except the source check, which is code. On the command line and in the test bench, a note that fails this check is delivered with a section that lists what it could not source; the run stops if no fact from the search has a source."
    />
    <p>
      The instructions given to the models are <code>.prompt</code> files read by PromptLang. The section of unsourced items is written by the code from the check’s report: no model can soften it.
    </p>
  </CaseSection>

  <CaseSection
    n={3}
    id="mesures"
    title="Measures"
    lead="What the real, paid runs give, and what is not measured at all."
  >
    <p>
      Of the real runs, <Figure id="praxis.live_completed" where="prose" /> reached the end; a completed note cost <Figure id="praxis.cost_per_briefing" where="prose" />. Every completed note is
      flagged as insufficiently sourced: <Figure id="praxis.insufficiently_sourced" where="prose" defect />. The flag is raised as soon as a single item blocks.
    </p>
    <h3>No point of comparison</h3>
    <p>
      Nothing in the repository compares Praxis with a simpler approach, a single model call or drafting without search. The only score published before rated simulated notes, written by hand for
      the tests: it measured those examples, not a model, and it was withdrawn (<a href={at("CHANGELOG.md")}>changelog</a>). The quality of the notes themselves is reviewed for no question; only
      the first-hand sources of one question were reviewed by a human (<a href={at("benchmarks/outputs/live/README.md")}>real runs</a>).
    </p>
    <MeasuresDetail>
      <MeasuresTable
        where="live"
        caption="Real, paid runs"
        rows={[
          {
            id: "praxis.live_completed",
            label: "Completed notes, out of the attempts",
            reading:
              "The other attempts failed: source check too strict, text before the structured response, time limit exceeded, truncated response, section refused.",
          },
          {
            id: "praxis.insufficiently_sourced",
            label: "Notes flagged as insufficiently sourced",
            defect: true,
            noInterval: "The repository publishes no interval for this count.",
            reading: "The main defect: every completed note is flagged. The flag is raised as soon as a single item blocks.",
          },
          {
            id: "praxis.cost_per_briefing",
            label: "Cost of a completed note",
            noInterval: "The range of the completed runs, from the cheapest to the most expensive: not an estimate.",
            reading: "Cost recorded with every completed run.",
          },
        ]}
      />
    </MeasuresDetail>
  </CaseSection>

  <CaseSection n={4} id="echecs" title="What did not work, and what I did" lead="Three real failures, their cause when it is known, and what each one changed.">
    <h3>Declared done without a single real note</h3>
    <p>
      Every stage and every format was built and tested on hand-written examples before the first real run. The tests could only prove that the stages fitted together, the test bench measured those
      examples, and the first real runs all failed. What I did: an independent audit, then fixes without any paid call (general instruction in its proper place, model chosen per stage, tolerant
      reading of the structured response, time limits per stage, resuming where the run had stopped, cost measurement), then real runs published, failures included (<a href={at("ROADMAP.md")}
        >fix plan</a
      >).
    </p>
    <h3>The strict check threw all the work away</h3>
    <p>
      In strict mode, a single item without a source cancelled every stage already done. No trace of those runs was kept: the cause is read in the instruction and the code, not observed. The search
      instruction required a consultation date that the model cannot know, which left only one compliant answer: “missing source”. Praxis now dates its consultations itself, which removes the
      probable cause without guaranteeing a source for every item, and the note is delivered with its gaps written into it (<a href={at("docs/adr/0002-degrade-on-insufficient-sourcing.md")}
        >ADR 0002</a
      >).
    </p>
    <h3>A section refused for a web address in its text</h3>
    <p>
      A summary section was refused, then refused again on the retry, this time for a <code>www.</code> address in the text, which document readers turn into a link. The fix (<a
        href={pull("praxis", 44)}>#44</a
      >) replaces that instruction with numbered references to the sources, checked by the code. No paid retry was run to “verify” it: the fix is not proven on a real run.
    </p>
  </CaseSection>

  <CaseSection
    n={5}
    id="decisions"
    title="Three decisions"
    lead="Three architecture choices, each written in a decision record (ADR) with its reasons and consequences: enough to judge the reasoning, not only the result."
  >
    <ol class="decisions">
      <li>
        <h3>Read the structured response in code, repairing nothing</h3>
        <p>
          Anthropic’s interface refuses responses in an imposed format when the web search cites its sources, and refuses to force a tool call on the models used. For the stages with search, the
          code keeps the text after the last tool call and extracts from it the largest complete and readable structured response (a JSON object), repairing nothing; the stages without search impose
          their format. In every case, the code validates each field.
        </p>
        <p><a href={at("docs/adr/0001-getting-json-from-the-model.md")}>ADR 0001</a></p>
      </li>
      <li>
        <h3>Deliver with a flag rather than give up</h3>
        <p>
          On the command line and in the test bench, a failed source check is recorded, the run continues, the report is flagged and the code adds a section that lists every blocking item. The note is
          complete, but says in its own text what it could not source. Used as a library, Praxis still gives up by default: changing the errors a public function can raise would break the code of
          those who call it.
        </p>
        <p><a href={at("docs/adr/0002-degrade-on-insufficient-sourcing.md")}>ADR 0002</a></p>
      </li>
      <li>
        <h3>Which sources to trust</h3>
        <p>
          A company’s website is accepted for that company’s facts only, provided that the mapping between organisations and websites is explicit, reviewed and versioned. After a human review, the rule
          never again accepts a first-hand source for the likelihood or impact of a risk. The second part, the specialist press, is not implemented.
        </p>
        <p><a href={at("docs/adr/0003-source-trust-criteria.md")}>ADR 0003</a></p>
      </li>
    </ol>
  </CaseSection>

  <CaseSection n={6} id="construction" title="How it is built" lead="For a technical reader: the stack, the models used and the test tools.">
    <p>
      TypeScript on Bun. Anthropic’s Messages programming interface (API), with its web search tool: <code>claude-opus-5-5</code> for scoping, options and the adversarial review,
      <code>claude-sonnet-5-5</code> for search, actors, risks and drafting. <code>@promptlang/core</code> from npm, pinned by its hash; pdfkit for the PDF, the Word file written by hand. Tests
      <code>bun test</code>, fast-check, Stryker. Architecture: <a href={at("docs/architecture.md")}>docs/architecture.md</a>.
    </p>
  </CaseSection>

  <CaseSection n={7} id="suite" title="What comes next" lead="What is missing, according to the project’s roadmap.">
    <ul>
      <li>A real run that ends reliably, and measured: cost, volume of text processed, duration, rated sample.</li>
      <li>The quality of real notes rated by a judge model, validated against human ratings, with its margin of error.</li>
      <li>The age of a source measured on the date of the page itself.</li>
      <li>A web search that filters its results along the way, evaluated against the base tool.</li>
    </ul>
    <p><a href={at("README.md#roadmap")}>Roadmap</a></p>
  </CaseSection>
</CaseStudy>
