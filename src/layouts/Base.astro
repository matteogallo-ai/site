---
import { Font } from "astro:assets";
import "../styles/global.css";
import Glass from "../components/Glass.astro";

interface Props {
  title: string;
  description: string;
  lang?: "fr" | "en";
  /** Pages that set text in the serif (the Verity contract, quotes) declare it; others never get its @font-face. */
  serif?: boolean;
}

const { title, description, lang = "fr", serif = false } = Astro.props;
const skipLabel = lang === "fr" ? "Aller au contenu" : "Skip to content";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-sans" preload />
    {serif && <Font cssVariable="--font-serif" />}
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <Glass />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
