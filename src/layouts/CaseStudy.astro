---
import Base from "./Base.astro";
import { langOf, numbered, twin } from "../lib/i18n.ts";
import { repoUrl } from "../lib/sources.ts";
import LangSwitch from "../components/LangSwitch.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import ProductShot from "../components/ProductShot.astro";

interface Props {
  /** Calibre number of the project, as on the home page cards ("01"). */
  no: string;
  name: string;
  /** One sentence: what the project is. */
  summary: string;
  description: string;
  repo: string;
  /** The page quotes a source in the serif (SPEC §4: quotes only). */
  serif?: boolean;
}

const { no, name, summary, description, repo, serif = false } = Astro.props;
const shot = name.toLowerCase();
if (shot !== "verity" && shot !== "promptlang" && shot !== "praxis") throw new Error(`no product image for ${name}`);
const lang = langOf(Astro.url.pathname);
const t = {
  fr: { title: "étude de cas", crumbs: "Fil d’Ariane", home: "/", projects: "/#projets", projectsLabel: "Projets", kind: "Étude de cas", code: "Code :", others: "Autres études de cas", all: "Études de cas" },
  en: { title: "case study", crumbs: "Breadcrumb", home: "/en/", projects: "/en/#projects", projectsLabel: "Projects", kind: "Case study", code: "Code:", others: "Other case studies", all: "Case studies" },
}[lang];
const cases = [
  { no: "01", name: "Verity", href: "/projets/verity/" },
  { no: "02", name: "PromptLang", href: "/projets/promptlang/" },
  { no: "03", name: "Praxis", href: "/projets/praxis/" },
].map((c) => ({ ...c, href: lang === "fr" ? c.href : twin(c.href) }));
---

<Base title={`${name} — ${t.title} · Matteo Gallo`} description={description} serif={serif}>
  <div class="container topbar" slot="header">
    <nav class="crumbs" aria-label={t.crumbs}>
      <a href={t.home}>Matteo Gallo</a>
      <span aria-hidden="true">/</span>
      <a href={t.projects}>{t.projectsLabel}</a>
    </nav>
    <LangSwitch />
  </div>
  <div class="container case">
    <header class="head">
      <p class="no"><span class="mono">{numbered(no, lang)}</span> · {t.kind}</p>
      <h1>{name}</h1>
      <p class="summary">{summary}</p>
      <p class="code"><a href={repoUrl(repo)}>{t.code} matteogallo-ai/{repo}</a></p>
    </header>
    <div class="case-shot"><ProductShot id={shot} size="lead" /></div>
    <slot />
    <nav class="others" aria-label={t.others}>
      <p class="rule-label">{t.all}</p>
      <ul>
        {
          cases.map((c) => (
            <li>
              {c.name === name ? (
                <span aria-current="page">
                  <span class="mono">{numbered(c.no, lang)}</span> {c.name}
                </span>
              ) : (
                <a href={c.href}>
                  <span class="mono">{numbered(c.no, lang)}</span> {c.name}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <section class="container section closing-contact" aria-label="Contact">
    <Contact />
  </section>
  <Footer />
</Base>

<style>
  .case {
    padding-block: 2rem 1rem;
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    color: var(--graphite);
  }

  .head {
    padding-block: 3rem 1rem;
    max-width: 44rem;
  }

  .no {
    margin: 0 0 0.75rem;
    font-size: var(--step-12);
    color: var(--graphite);
  }

  h1 {
    font-size: var(--step-44);
    letter-spacing: var(--track-44);
  }

  @media (min-width: 48rem) {
    h1 {
      font-size: var(--step-68);
      letter-spacing: var(--track-68);
    }
  }

  .summary {
    margin: 1rem 0 0;
    font-size: var(--step-21);
  }

  .code {
    margin: 1rem 0 0;
  }

  /* Prose of the sections: a reading measure of about 70 characters; tables run wider. */
  .case :global(.case-section > p),
  .case :global(.case-section > ul),
  .case :global(.case-section > ol),
  .case :global(.case-section > blockquote) {
    max-width: 34rem;
  }

  /* Wide screens: the diagram stands in its own column beside the section's text, instead of a
     narrow column with two thirds of the line empty. */
  @media (min-width: 64rem) {
    .case :global(.case-section:has(> .diagram)) {
      display: grid;
      grid-template-columns: minmax(0, 34rem) minmax(0, 30rem);
      column-gap: 4rem;
      align-items: start;
    }

    .case :global(.case-section:has(> .diagram) > *) {
      grid-column: 1;
    }

    .case :global(.case-section:has(> .diagram) > .diagram) {
      grid-column: 2;
      grid-row: 2 / span 8;
      margin-top: 0;
    }
  }

  /* The section's first sentence: what it gives the reader. */
  .case :global(.case-section > .lead) {
    margin: 0.5rem 0 1.25rem;
    font-size: var(--step-16);
    color: var(--graphite);
  }

  .case :global(.case-section > h3) {
    margin-top: 2.5rem;
    font-size: var(--step-21);
  }

  /* The sans subset has no bullet (U+2022): the en dash it does have marks the items, as
     pseudo-element text that the glyph test reads. */
  .case :global(.case-section > ul) {
    padding: 0;
    list-style: none;
  }

  .case :global(.case-section > ul > li) {
    position: relative;
    padding-left: 1.25em;
  }

  .case :global(.case-section > ul > li)::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--graphite);
  }

  .case :global(.case-section li + li) {
    margin-top: 0.5rem;
  }

  .case :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--rule);
  }

  .case :global(blockquote p) {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--step-21);
    line-height: 1.45;
  }

  /* A French translation under an English quote, as in the demo: small, in the sans, indented. */
  .case :global(blockquote .tr) {
    margin-top: 0.4rem;
    padding-left: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--step-14);
    line-height: 1.5;
    color: var(--graphite);
  }

  .case :global(blockquote .tr-k) {
    margin-right: 0.25rem;
    font-weight: 600;
  }

  .case :global(blockquote footer) {
    margin-top: 0.5rem;
    font-size: var(--step-14);
    color: var(--graphite);
  }

  .case :global(.sic) {
    font-family: var(--font-sans);
    font-size: var(--step-14);
    color: var(--defect);
  }

  .case :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .case :global(.decisions) {
    padding: 0;
    list-style: none;
  }

  .case :global(.decisions li + li) {
    margin-top: 1.5rem;
  }

  .case :global(.decisions h3) {
    font-size: var(--step-16);
  }

  .case :global(.decisions p) {
    margin: 0.35rem 0 0;
  }

  .others {
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .others ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .others .mono {
    font-size: var(--step-12);
    color: var(--graphite);
  }

  [aria-current="page"] {
    color: var(--graphite);
  }
</style>
